---
// Marco de la zona «panel» para la versión PHP: el contenido lo dibuja php/app/pages/ dentro de esta cáscara.
// Las marcas @@…@@ las rellena php/app/shell.php. Solo se compila con `npm run build:php` (ver docs/PHP.md).
import Privado from '../layouts/Privado.astro';
import '../components/tele/tele.css';
import '../styles/paginas/panel.css';
---
<Privado titulo="@@TITULO@@" zona="@@ZONA@@" usuario={{ nombre: '@@USUARIO_NOMBRE@@', rol: 'cliente' }} rolTexto="@@USUARIO_ROL@@">
  <Fragment slot="head" set:html="@@HEAD@@" />
  <Fragment set:html="@@CONTENIDO@@" />
</Privado>

<script>
  import '../scripts/paginas/panel.ts';
  import '../scripts/videollamada-auto.ts';
</script>
