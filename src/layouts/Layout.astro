---
// Layout público. Fuentes y paleta del sitio actual (Montserrat + Open Sans, azul #014DB7); movimiento con motion.js.
// Dos modos (docs/BACKEND.md): <html> lleva data-demo y data-base; todo enlace interno pasa por u().
import '@fontsource-variable/montserrat/index.css';
import '@fontsource-variable/open-sans/index.css';
import montserrat from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import openSans from '@fontsource-variable/open-sans/files/open-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import { DEMO, u } from '../lib/entorno';
import { clinica } from '../data/site';
import { waHref } from '../lib/sitio';

interface Props {
  titulo: string; // «{titulo} · Policlínica Maracaibo» (si ya nombra a la clínica se usa tal cual)
  descripcion?: string;
  noindex?: boolean;
}
const {
  titulo,
  descripcion = 'Policlínica Maracaibo, desde 1952: servicios, directorio médico, emergencias las 24 horas y telemedicina para afiliados. Av. 8 Santa Rita, Maracaibo.',
  noindex = DEMO,
} = Astro.props;

const titular = titulo.includes(clinica.nombre) ? titulo : `${titulo} · ${clinica.nombre}`;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: clinica.nombre,
  url: new URL(u('/'), Astro.site).href,
  foundingDate: String(clinica.desde),
  telephone: ['+582617005100', '+582617005141'],
  email: clinica.correo,
  address: { '@type': 'PostalAddress', streetAddress: clinica.direccion, addressLocality: 'Maracaibo', addressCountry: 'VE' },
  sameAs: [clinica.instagram.href],
};
---
<!doctype html>
<html lang="es-VE" data-demo={DEMO ? '1' : undefined} data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- js: activa las animaciones; si motion.js no llega en 2.5 s, todo se muestra igual -->
    <!-- pin-ok: escritorio con movimiento → el héroe con data-pin se maqueta ya como escena fijada (misma condición que motion.js) -->
    <script is:inline>var h=document.documentElement;h.classList.add('js');if(matchMedia('(min-width: 1101px) and (prefers-reduced-motion: no-preference)').matches)h.classList.add('pin-ok');setTimeout(function(){h.classList.add('motion-ready')},2500);</script>
    <title>{titular}</title>
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonica} />
    <link rel="icon" href={u('/favicon.png')} type="image/png" />
    <meta name="theme-color" content="#014db7" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:title" content={titular} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={new URL(u('/og.jpg'), Astro.site).href} />
    <link rel="preload" as="font" type="font/woff2" href={montserrat} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={openSans} crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1"><slot /></main>
    <Footer />
    <a class="wa-float" href={waHref()} target="_blank" rel="noopener" aria-label="¿Necesitas ayuda? Escríbenos por WhatsApp">
      <i><Icon name="whatsapp" /></i><span>¿Necesitas ayuda?</span>
    </a>
    <script>import '../scripts/motion.js';</script>
  </body>
</html>
