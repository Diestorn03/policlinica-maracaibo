---
// Una fila de la cola del médico. La usan el servidor (filas reales) y el <template> que clona el script (sin `c`).
import { esperando } from '../../lib/sitio';
import { aFecha } from '../../lib/tele';

interface Props { c?: { id: number; paciente: string; edad: number | null; motivo: string; creada: string }; orden?: number }
const { c, orden = 1 } = Astro.props;
const seg = c ? (Date.now() - aFecha(c.creada).getTime()) / 1000 : 0;
---
<tr data-id={c?.id} data-creada={c?.creada}>
  <td data-etiqueta="Turno" data-campo="orden">{c ? orden : ''}</td>
  <td data-etiqueta="Paciente"><div><b data-campo="paciente">{c?.paciente}</b><small data-campo="siguiente">{c && orden === 1 ? 'Siguiente' : ''}</small></div></td>
  <td data-etiqueta="Edad" data-campo="edad">{c ? (c.edad == null ? 'Sin registrar' : `${c.edad} años`) : ''}</td>
  <td data-etiqueta="Esperando"><div><time data-campo="reloj">{c ? esperando(c.creada) : ''}</time><small data-campo="largo">{seg >= 1200 ? 'Más de 20 min' : seg >= 600 ? 'Más de 10 min' : ''}</small></div></td>
  <td data-etiqueta="Motivo" data-campo="motivo">{c ? c.motivo || 'Sin motivo indicado' : ''}</td>
  <td><button type="submit" name="consulta" value={c?.id} class="btn btn--primary btn--sm" aria-label={c ? `Atender a ${c.paciente}` : undefined}>Atender</button></td>
</tr>
