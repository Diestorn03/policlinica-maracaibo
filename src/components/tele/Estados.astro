---
// Las cuatro pantallas del panel del cliente (DESIGN.md §7.3): 0 inicio · 1 sala de espera · 2 te atienden · 3 terminó / saliste.
// El servidor pinta la inicial según estado(); el script (abajo) las cambia sin recargar sondeando espera() de api.js.
// En la demo (página estática) el HTML nace en «inicio» y se oculta hasta la primera respuesta para que no parpadee.
import Icono from '../ui/Icono.astro';
import Chip from '../ui/Chip.astro';
import { DEMO, u } from '../../lib/entorno';
import { esperando, waHref } from '../../lib/sitio';
import type { Activa } from '../../lib/tele';

interface Props {
  consulta: Activa | null;
  nombre: string;
  vence: string | null;   // afiliacion_vence (AAAA-MM-DD)
  error: string;
}
const { consulta, nombre, vence, error } = Astro.props;

const inicial = !consulta ? 'inicio' : consulta.estado === 'espera' ? 'espera' : 'atiende';
const tema = { inicio: 'cal', espera: 'lago', atiende: 'sol', fin: 'cal' };
const primer = nombre.split(/\s+/)[0];

// Afiliación: Vigente / Por vencer (≤ 30 días) / Vencida, contra el día de hoy en Caracas (el último día aún vale)
const hoy = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Caracas' }).format(new Date());
const dias = vence ? Math.round((Date.parse(vence) - Date.parse(hoy)) / 864e5) : null;
const af = dias == null ? null : dias < 0
  ? { chip: 'Vencida', clase: 'chip--vencida', icono: 'alerta', verbo: 'venció el' }
  : dias <= 30
    ? { chip: 'Por vencer', clase: 'chip--por-vencer', icono: 'reloj', verbo: 'vence el' }
    : { chip: 'Vigente', clase: 'chip--vigente', icono: 'check', verbo: 'hasta el' };
const fechaVence = vence ? new Intl.DateTimeFormat('es-VE', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(vence)) : '';

const n = consulta ? Math.min(consulta.posicion - 1, 7) : 0;   // anillos = personas delante, máx. 7
const delante = (c: number) => (c === 0 ? 'Eres el siguiente.' : `Hay ${c} ${c === 1 ? 'persona' : 'personas'} antes que tú.`);
const largo = !!consulta && consulta.estado === 'espera' && (Date.now() - Date.parse(consulta.creada.replace(' ', 'T') + 'Z')) / 6e4 > 10;
const enlace = consulta?.enlace ?? '';
---

<div data-estados data-actual={inicial} data-cargando={DEMO ? '' : undefined}>
  <div role="status" aria-live="polite" class="tele-col">
    <p class="aviso aviso--info" data-sin-conexion hidden>Sin conexión. Seguimos intentando…</p>
  </div>

  <!-- 0 · Inicio -->
  <section class="estado" data-estado="inicio" data-tema={tema.inicio} hidden={inicial !== 'inicio'} aria-labelledby="t-inicio">
    <div class="tele-col pila">
      <h1 id="t-inicio" tabindex="-1">Hola, {primer}</h1>
      {af && (
        <p class="afiliacion">
          <Chip texto={af.chip} icono={af.icono as 'check'} clase={af.clase} />
          <span>{af.verbo} {fechaVence}</span>
        </p>
      )}
      <div class="aviso aviso--error" role="alert" tabindex="-1" data-error hidden={!error}>
        <p>{error}</p>
        <a class="btn btn--sol btn--sm" href={waHref('Renovar mi afiliación')} target="_blank" rel="noopener">Renovar mi afiliación</a>
      </div>
      <div class="tarjeta tele-tarjeta pila">
        <h2>Consulta por videollamada</h2>
        <p>Pulsa el botón. Quedarás en la sala de espera y un médico te atenderá por orden de llegada.</p>
        <form method="post" action={u('/api/espera')} class="pila" data-entrar>
          <input type="hidden" name="accion" value="entrar" />
          <details class="motivo">
            <summary>¿Quieres contarle algo al médico? (opcional)</summary>
            <label class="solo-lectores" for="motivo">Motivo de la consulta</label>
            <textarea class="area" id="motivo" name="motivo" maxlength="200" rows="3"></textarea>
          </details>
          <button class="btn btn--lago btn--grande btn--bloque btn--entrar" type="submit"><Icono nombre="video" tam={32} /><span>Entrar a la videollamada</span></button>
        </form>
      </div>
    </div>
  </section>

  <!-- 1 · Sala de espera -->
  <section class="estado estado--sala" data-estado="espera" data-tema={tema.espera} hidden={inicial !== 'espera'} aria-labelledby="t-espera">
    <div class="tele-col sala">
      <div class="sala-visual" aria-hidden="true">
        {[7, 6, 5, 4, 3, 2, 1].map((i) => <span class:list={['sala-anillo', { 'is-fuera': i > n }]} style={`--i:${i}`} data-i={i}></span>)}
        <div class="sala-disco respira"><span data-posicion>{consulta?.posicion ?? 1}</span></div>
      </div>
      <h1 id="t-espera" tabindex="-1">Estás en la sala de espera</h1>
      <p class="sala-linea" data-linea>{delante(n)}</p>
      <p class="sala-reloj" aria-hidden="true">Esperando: <time data-reloj data-creada={consulta?.creada}>{consulta ? esperando(consulta.creada) : '00:00'}</time></p>
      <p>No cierres esta página. Cuando un médico te atienda, aquí aparecerá el botón para entrar a la videollamada.</p>
      <div class="aviso aviso--info" data-largo hidden={!largo}>
        <p>Está tardando más de lo normal. Puedes seguir esperando o escribirnos por WhatsApp.</p>
        <a class="btn btn--sol btn--sm" href={waHref('Consulta de telemedicina')} target="_blank" rel="noopener"><Icono nombre="whatsapp" />WhatsApp</a>
      </div>
      <div class="sala-lista">
        <h2>Mientras esperas</h2>
        <ol>
          <li>Permite el uso de la cámara y el micrófono si tu navegador te lo pide.</li>
          <li>Busca un lugar con buena luz y poco ruido.</li>
          <li>Ten a mano tus informes o estudios, si los tienes.</li>
        </ol>
      </div>
      <form method="post" action={u('/api/espera')}>
        <input type="hidden" name="accion" value="cancelar" />
        <button class="btn btn--borde" type="submit">Salir de la sala</button>
      </form>
      <p class="solo-lectores" role="status" aria-live="polite" data-anuncio></p>
    </div>
  </section>

  <!-- 2 · Te atienden -->
  <section class="estado estado--atiende" data-estado="atiende" data-tema={tema.atiende} hidden={inicial !== 'atiende'} aria-labelledby="t-atiende">
    <div class="tele-col pila">
      <div role="alert"><h1 id="t-atiende" tabindex="-1"><span data-medico>{consulta?.medico || 'Un médico'}</span> te está esperando.</h1></div>
      <a class="btn btn--lago btn--grande btn--bloque" data-enlace href={enlace || undefined} target="_blank" rel="noopener">
        <Icono nombre="video" tam={32} /><span>Abrir la videollamada<span class="solo-lectores"> (se abre en otra pestaña)</span></span>
      </a>
      <p>Si no se abre, copia este enlace:</p>
      <p class="enlace-texto" data-enlace-texto>{enlace}</p>
      <button class="btn btn--borde btn--sm" type="button" data-copiar={enlace}><Icono nombre="copiar" /><span data-txt aria-live="polite">Copiar enlace</span></button>
    </div>
  </section>

  <!-- 3 · Terminó / saliste -->
  <section class="estado" data-estado="fin" data-tema={tema.fin} hidden aria-labelledby="t-fin">
    <div class="tele-col pila">
      <h1 id="t-fin" tabindex="-1"><span data-fin="termino">La consulta terminó.</span><span data-fin="salio" hidden>Saliste de la sala.</span></h1>
      <p data-fin="termino">Gracias por conectarte.</p>
      <p data-fin="salio" hidden>Cerraste o dejaste esta página. Cuando quieras, vuelve a entrar.</p>
      <a class="btn btn--lago btn--grande btn--bloque" href={u('/panel/')}>Volver al inicio</a>
    </div>
  </section>
</div>

<script>
  import { espera } from '../../scripts/api.js';
  import { sondear, errorDeUrl, enlaceSeguro } from './tele.js';
  import { esperando } from '../../lib/sitio.ts';
  import { aFecha } from '../../lib/tele.ts';

  const raiz = document.querySelector<HTMLElement>('[data-estados]');
  if (raiz) {
    const $ = <T extends HTMLElement = HTMLElement>(s: string, r: ParentNode = raiz) => r.querySelector<T>(s)!;
    const secciones = Object.fromEntries(['inicio', 'espera', 'atiende', 'fin'].map((e) => [e, $(`[data-estado="${e}"]`)]));
    const base = document.title;
    let actual = raiz.dataset.actual!;
    let posicion = Number($('[data-posicion]').textContent) || 0;
    let candado: WakeLockSentinel | null = null;

    errorDeUrl($('[data-error]'));

    // «Entrando…» al pulsar el botón grande (y se restablece si vuelven con «atrás»)
    const entrar = $('[data-entrar]');
    const btnEntrar = $('.btn--entrar', entrar);
    const etiqueta = btnEntrar.querySelector('span')!;
    entrar.addEventListener('submit', () => { btnEntrar.setAttribute('aria-busy', 'true'); etiqueta.textContent = 'Entrando…'; });
    addEventListener('pageshow', (e) => { if (e.persisted) { btnEntrar.removeAttribute('aria-busy'); etiqueta.textContent = 'Entrar a la videollamada'; } });

    // La pantalla del teléfono no se apaga mientras esperas (mejora progresiva)
    const pedirCandado = async () => { try { if (!candado || candado.released) candado = (await navigator.wakeLock?.request('screen')) ?? null; } catch {} };
    const soltarCandado = () => { candado?.release().catch(() => {}); candado = null; };
    document.addEventListener('visibilitychange', () => { if (!document.hidden && actual === 'espera') pedirCandado(); });

    const ir = (e: string, variante = '') => {
      const antes = actual;
      actual = e;
      for (const [k, s] of Object.entries(secciones)) s.hidden = k !== e;
      raiz.querySelectorAll('[data-fin]').forEach((p) => ((p as HTMLElement).hidden = (p as HTMLElement).dataset.fin !== variante));
      document.title = e === 'atiende' ? '¡Te están esperando! · Policlínica Maracaibo' : base;
      if (e === 'espera') pedirCandado(); else soltarCandado();
      if (antes !== e) $(e === 'atiende' ? '[data-enlace]' : 'h1', secciones[e]).focus();
      if (e === 'atiende' && antes !== e) navigator.vibrate?.([200, 100, 200]);
    };

    const pintar = (c: any) => {
      if (!c) {
        if (actual === 'atiende') ir('fin', 'termino');
        else if (actual === 'espera') ir('fin', 'salio');
        return;
      }
      if (c.estado === 'espera') {
        const delante = Math.max(0, c.posicion - 1), n = Math.min(delante, 7);
        $('[data-posicion]').textContent = c.posicion;
        $('[data-linea]').textContent = delante === 0 ? 'Eres el siguiente.' : `Hay ${delante} ${delante === 1 ? 'persona' : 'personas'} antes que tú.`;
        $('[data-reloj]').dataset.creada = c.creada;
        secciones.espera.querySelectorAll<HTMLElement>('[data-i]').forEach((a) => a.classList.toggle('is-fuera', Number(a.dataset.i) > n));
        if (posicion && c.posicion !== posicion) $('[data-anuncio]').textContent = `Tu posición cambió: ${delante === 0 ? 'eres el siguiente' : `ahora hay ${delante} ${delante === 1 ? 'persona' : 'personas'} antes que tú`}.`;
        posicion = c.posicion;
        if (actual !== 'espera') ir('espera');
      } else {
        const url = enlaceSeguro(c.enlace);
        $('[data-medico]').textContent = c.medico || 'Un médico';
        const a = $<HTMLAnchorElement>('[data-enlace]');
        if (url) a.href = url; else a.removeAttribute('href');
        $('[data-enlace-texto]').textContent = url;
        $('[data-copiar]').dataset.copiar = url;
        if (actual !== 'atiende') ir('atiende');
      }
    };

    // Reloj de la espera (cada segundo) y aviso de «tarda más de lo normal» pasados 10 minutos
    setInterval(() => {
      if (actual !== 'espera') return;
      const t = $('[data-reloj]');
      if (!t.dataset.creada) return;
      t.textContent = esperando(t.dataset.creada);
      if (Date.now() - aFecha(t.dataset.creada).getTime() > 10 * 6e4) $('[data-largo]').hidden = false;
    }, 1000);

    sondear(
      async () => {
        const r = await espera();
        if (r) pintar(r.consulta);
        raiz.removeAttribute('data-cargando');
      },
      (ok) => { $('[data-sin-conexion]').hidden = ok; if (!ok) raiz.removeAttribute('data-cargando'); },
    );
  }
</script>
