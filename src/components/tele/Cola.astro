---
// Sala de espera del médico en vivo (DESIGN.md §7.4): encabezado, cola (un solo <form id="cola">), consultas en curso y diálogo de «Finalizar».
// El servidor pinta lo que hay; el script sondea cola() de api.js cada 4 s y reconcilia por id (no reconstruye: no se pierde el foco).
// En la demo (página estática) el HTML nace vacío y se llena con la primera respuesta, para no mostrar filas del momento de compilar.
import Anillos from '../ui/Anillos.astro';
import FilaCola from './FilaCola.astro';
import TarjetaCurso from './TarjetaCurso.astro';
import { DEMO, u } from '../../lib/entorno';
import type { EnCola } from '../../lib/tele';

interface Props {
  espera: EnCola[];
  enCurso: (EnCola & { enlace: string })[];
  error: string;
  atendiendo: string;   // ?atendiendo=<id>
}
const { espera, enCurso, error, atendiendo } = Astro.props;
const tomado = enCurso.some((c) => String(c.id) === atendiendo);
---

<div data-cola>
  <header class="medico-cab">
    <h1>Sala de espera</h1>
    <div class="medico-estado">
      <span class="chip chip--neutro" data-contador>{espera.length} en espera</span>
      <span class="en-vivo js-solo"><span class="latido" aria-hidden="true"></span>En vivo<span class="actualizado"> · Actualizado <time data-actualizado></time></span></span>
      <button type="button" class="btn btn--borde btn--sm js-solo" aria-pressed="false" data-sonido>Sonido de aviso: <span data-sonido-txt>Desactivado</span></button>
    </div>
  </header>

  <p class="solo-lectores" role="status" aria-live="polite" data-anuncio></p>
  <div role="status" aria-live="polite"><p class="aviso aviso--info" data-sin-conexion hidden>Sin conexión. Seguimos intentando…</p></div>
  <div class="aviso aviso--error" role="alert" tabindex="-1" data-error hidden={!error}><p>{error}</p></div>
  <div class="aviso aviso--ok" role="status" data-tomado hidden={!tomado}><p>Paciente tomado. Abre la videollamada para atenderlo.</p></div>

  <div class="medico-grid">
    <section class="curso" aria-labelledby="t-curso">
      <h2 id="t-curso">En curso</h2>
      <ul class="curso-lista lista-limpia" data-curso>
        {enCurso.map((c) => <TarjetaCurso c={c} actual={String(c.id) === atendiendo} />)}
      </ul>
      <p class="vacio-txt" data-curso-vacio hidden={enCurso.length > 0 || DEMO}>No tienes consultas en curso.</p>
    </section>

    <section class="cola" aria-labelledby="t-cola">
      <h2 id="t-cola">Pacientes en espera</h2>
      <form id="cola" method="post" action={u('/api/cola')} class="pila">
        <input type="hidden" name="accion" value="atender" />
        <div class="campo meet">
          <label class="campo__etiqueta" for="enlace">Mi enlace de Google Meet (opcional)</label>
          <input class="entrada entrada--lg" type="url" id="enlace" name="enlace" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://meet.google.com/abc-defg-hij" />
          <p class="campo__ayuda">Si lo dejas vacío, se crea una sala de videollamada automática (Jitsi).</p>
        </div>
        <div class="tabla-envoltura" data-tabla hidden={espera.length === 0}>
          <table class="tabla cola-tabla">
            <caption class="solo-lectores">Pacientes en espera, por orden de llegada</caption>
            <thead><tr><th scope="col">Orden</th><th scope="col">Paciente</th><th scope="col">Edad</th><th scope="col">Esperando</th><th scope="col">Motivo</th><th scope="col"><span class="solo-lectores">Acción</span></th></tr></thead>
            <tbody data-filas>
              {espera.map((c, i) => <FilaCola c={c} orden={i + 1} />)}
            </tbody>
          </table>
        </div>
        <div class="vacio" data-vacio hidden={espera.length > 0 || DEMO}>
          <Anillos paso={9} tam="12rem" clase="vacio-anillos" />
          <p>No hay pacientes en espera. Esta página se actualiza sola.</p>
        </div>
        <p class="vacio-txt" data-cargando-txt hidden={!DEMO}>Cargando la sala de espera…</p>
      </form>
    </section>
  </div>

  <template id="pl-fila"><FilaCola /></template>
  <template id="pl-curso"><TarjetaCurso /></template>

  <dialog class="dialogo" id="dialogo-fin" aria-labelledby="dialogo-fin-t">
    <h2 id="dialogo-fin-t">¿Finalizar la consulta con <span data-dialogo-paciente></span>?</h2>
    <form method="dialog" class="acciones dialogo-acciones">
      <button class="btn btn--borde" value="no" autofocus>Cancelar</button>
      <button class="btn btn--lago" value="si">Sí, finalizar</button>
    </form>
  </dialog>
</div>

<script>
  import { cola } from '../../scripts/api.js';
  import { sondear, errorDeUrl } from './tele.js';
  import { esperando } from '../../lib/sitio.ts';
  import { aFecha } from '../../lib/tele.ts';

  const raiz = document.querySelector<HTMLElement>('[data-cola]');
  if (raiz) {
    const $ = <T extends HTMLElement = HTMLElement>(s: string, r: ParentNode = raiz) => r.querySelector<T>(s)!;
    const guardado = (k: string, v?: string) => { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch {} return null; };
    const base = document.title;
    const cuerpo = $('[data-filas]'), lista = $('[data-curso]');
    const plFila = $<HTMLTemplateElement>('#pl-fila'), plCurso = $<HTMLTemplateElement>('#pl-curso');
    const filas = new Map<string, HTMLElement>(), cards = new Map<string, HTMLElement>();
    const atendiendo = new URLSearchParams(location.search).get('atendiendo') ?? '';
    let primera = true, enfocado = false, audio: AudioContext | null = null, sonido = guardado('pm-aviso') === '1';
    cuerpo.querySelectorAll<HTMLElement>('tr[data-id]').forEach((tr) => filas.set(tr.dataset.id!, tr));
    lista.querySelectorAll<HTMLElement>('li[data-id]').forEach((li) => cards.set(li.dataset.id!, li));
    const poner = (el: ParentNode, campo: string, v: string) => { const n = el.querySelector(`[data-campo="${campo}"]`); if (n) n.textContent = v; };

    errorDeUrl($('[data-error]'));

    // Mi enlace de Meet: se recuerda en este navegador
    const meet = $<HTMLInputElement>('#enlace');
    if (!meet.value) meet.value = guardado('pm-meet') ?? '';
    meet.addEventListener('change', () => guardado('pm-meet', meet.value.trim()));

    // Sonido de aviso (apagado por defecto): un tono de 0.25 s con WebAudio, solo cuando llega alguien y el usuario ya tocó la página
    const btnSonido = $('[data-sonido]');
    const pintarSonido = () => { btnSonido.setAttribute('aria-pressed', String(sonido)); $('[data-sonido-txt]').textContent = sonido ? 'Activado' : 'Desactivado'; };
    const abrirAudio = () => { if (sonido && !audio) audio = new AudioContext(); };
    const tono = () => {
      if (!sonido || !audio) return;
      const o = audio.createOscillator(), g = audio.createGain(), t = audio.currentTime;
      o.frequency.value = 880; g.gain.setValueAtTime(.15, t); g.gain.exponentialRampToValueAtTime(.001, t + .25);
      o.connect(g).connect(audio.destination); o.start(t); o.stop(t + .25);
    };
    pintarSonido();
    addEventListener('pointerdown', abrirAudio, { once: true });
    addEventListener('keydown', abrirAudio, { once: true });
    btnSonido.addEventListener('click', () => { sonido = !sonido; guardado('pm-aviso', sonido ? '1' : '0'); pintarSonido(); abrirAudio(); audio?.resume(); tono(); });

    // Finalizar con confirmación (sin JS el formulario se envía directo)
    const dialogo = $<HTMLDialogElement>('#dialogo-fin');
    let pendiente: HTMLFormElement | null = null;
    raiz.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-finalizar]');
      if (!b || typeof dialogo.showModal !== 'function') return;
      e.preventDefault();
      pendiente = b.closest('form');
      $('[data-dialogo-paciente]').textContent = b.closest('li')?.querySelector('h3')?.textContent ?? 'este paciente';
      dialogo.showModal();
    });
    dialogo.addEventListener('close', () => { if (dialogo.returnValue === 'si') pendiente?.requestSubmit(); dialogo.returnValue = ''; pendiente = null; });

    // Lo que se ve en el encabezado y el reloj de cada fila (cada segundo)
    const reloj = () => {
      const ahora = new Date();
      for (const tr of Array.from(cuerpo.children) as HTMLElement[]) {
        const seg = (ahora.getTime() - aFecha(tr.dataset.creada!).getTime()) / 1000;
        poner(tr, 'reloj', esperando(tr.dataset.creada!, ahora));
        $('[data-chip="10"]', tr).hidden = seg < 600 || seg >= 1200;
        $('[data-chip="20"]', tr).hidden = seg < 1200;
      }
    };
    setInterval(reloj, 1000);

    const crear = (pl: HTMLTemplateElement, c: any) => {
      const el = pl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      el.dataset.id = c.id;
      poner(el, 'paciente', c.paciente);
      return el;
    };
    // Pone `el` en la posición `i` de `padre` sin mover los demás (conserva foco y selección)
    const colocar = (padre: HTMLElement, el: HTMLElement, i: number) => { if (padre.children[i] !== el) padre.insertBefore(el, padre.children[i] ?? null); };

    function reconciliar(datos: { espera: any[]; enCurso: any[] }) {
      // --- cola
      const llegaron: string[] = [];
      const ids = new Set(datos.espera.map((c) => String(c.id)));
      for (const [id, tr] of filas) if (!ids.has(id)) { tr.remove(); filas.delete(id); }
      datos.espera.forEach((c, i) => {
        let tr = filas.get(String(c.id));
        if (!tr) {
          tr = crear(plFila, c);
          tr.dataset.creada = c.creada;   // solo al verla por primera vez: así el reloj no se reinicia en cada sondeo
          poner(tr, 'edad', c.edad == null ? '—' : `${c.edad} años`);
          poner(tr, 'motivo', c.motivo || '—');
          const b = $<HTMLButtonElement>('button', tr);
          b.value = c.id; b.setAttribute('aria-label', `Atender a ${c.paciente}`);
          if (!primera) { tr.classList.add('destello'); llegaron.push(c.paciente); }
          filas.set(String(c.id), tr);
        }
        colocar(cuerpo, tr, i);
        poner(tr, 'orden', String(i + 1));
        $('[data-chip="siguiente"]', tr).hidden = i !== 0;
      });
      reloj();
      $('[data-tabla]').hidden = datos.espera.length === 0;
      $('[data-vacio]').hidden = datos.espera.length > 0;
      $('[data-cargando-txt]').hidden = true;
      $('[data-contador]').textContent = `${datos.espera.length} en espera`;

      // --- en curso
      const idsCurso = new Set(datos.enCurso.map((c) => String(c.id)));
      for (const [id, li] of cards) if (!idsCurso.has(id)) { li.remove(); cards.delete(id); }
      datos.enCurso.forEach((c, i) => {
        let li = cards.get(String(c.id));
        if (!li) {
          li = crear(plCurso, c);
          poner(li, 'edad', c.edad == null ? 'Edad —' : `${c.edad} años`);
          poner(li, 'motivo', c.motivo || 'Sin motivo indicado');
          $('[name="consulta"]', li).setAttribute('value', c.id);
          $('[data-finalizar]', li).setAttribute('aria-label', `Finalizar consulta con ${c.paciente}`);
          const url = /^https:\/\/\S+$/.test(c.enlace) ? c.enlace : '';
          li.querySelector('[data-campo="enlace"]')!.setAttribute('href', url);
          $('[data-copiar]', li).dataset.copiar = url;
          cards.set(String(c.id), li);
        }
        colocar(lista, li, i);
      });
      $('[data-curso-vacio]').hidden = datos.enCurso.length > 0;

      // --- ?atendiendo=<id>: resalta esa consulta, avisa y lleva el foco a «Abrir videollamada» (una sola vez)
      const actual = cards.get(atendiendo);
      cards.forEach((li) => (li === actual ? li.setAttribute('aria-current', 'true') : li.removeAttribute('aria-current')));
      $('[data-tomado]').hidden = !actual;
      if (actual && !enfocado) { enfocado = true; $<HTMLElement>('[data-campo="enlace"]', actual).focus(); }

      // --- llegadas nuevas: aviso para lectores de pantalla, título de la pestaña y tono
      if (llegaron.length) { $('[data-anuncio]').textContent = `Llegó un paciente: ${llegaron.join(', ')}`; tono(); }
      document.title = datos.espera.length ? `(${datos.espera.length}) Sala de espera · Policlínica Maracaibo` : base;
      $('[data-actualizado]').textContent = new Intl.DateTimeFormat('es-VE', { timeZone: 'America/Caracas', hour: 'numeric', minute: '2-digit', second: '2-digit' }).format(new Date());
      primera = false;
    }

    sondear(
      async () => { const d = await cola(); if (d) reconciliar(d); },
      (ok) => { $('[data-sin-conexion]').hidden = ok; if (!ok) $('[data-cargando-txt]').hidden = true; },
    );
  }
</script>
