---
// Contenedor común de la videollamada (WebRTC propio, sin cuentas) para médico y cliente. El script observa tanto el HTML inicial como tarjetas que llegan por sondeo.
// ICE_SERVERS (JSON, opcional) añade servidores TURN para redes que bloquean la conexión directa; por defecto solo STUN público.
import { getEnv } from '../../lib/entorno';
interface Props { sala?: string; rol: 'medico' | 'cliente' }
const { sala = '', rol } = Astro.props;
const ice = (await getEnv()).ICE_SERVERS || '';
---
<div class="t-video" data-video data-sala={sala} data-rol={rol} data-ice={ice} tabindex="-1">
  <p class="t-video__estado" data-video-estado role="status">Preparando la videollamada…</p>
  <div class="t-video__marco" data-video-marco></div>
  <p class="t-video__nota">La videollamada se conecta sola, sin cuentas ni contraseñas. Permite cámara y micrófono cuando el navegador lo solicite.</p>
</div>

<script>
  import '../../scripts/videollamada-auto.ts';
</script>
