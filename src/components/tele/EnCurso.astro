---
// Una consulta en curso del médico. La sala Jitsi se monta automáticamente dentro de la tarjeta; no hay URL visible.
import { u } from '../../lib/entorno';
import Videollamada from './Videollamada.astro';

interface Props { c?: { id: number; paciente: string; edad: number | null; motivo: string; sala: string }; actual?: boolean }
const { c, actual = false } = Astro.props;
---
<li class="t-encurso" data-id={c?.id} aria-current={actual ? 'true' : undefined}>
  <div class="t-encurso__quien">
    <h3 data-campo="paciente">{c?.paciente}</h3>
    <p data-campo="edad">{c ? (c.edad == null ? 'Edad sin registrar' : `${c.edad} años`) : ''}</p>
    <p>Motivo: <span data-campo="motivo">{c ? c.motivo || 'sin motivo indicado' : ''}</span></p>
  </div>
  <Videollamada sala={c?.sala} rol="medico" />
  <form class="t-finalizar" method="post" action={u('/api/cola')}>
    <input type="hidden" name="accion" value="finalizar" />
    <input type="hidden" name="consulta" value={c?.id} />
    <label class="t-campo"><span>Diagnóstico</span><textarea class="textarea" name="diagnostico" required minlength="3" maxlength="1000" rows="3" placeholder="Escribe el diagnóstico registrado durante la consulta"></textarea><small>Obligatorio para finalizar. Lo verán el cliente, el médico y administración.</small></label>
    <button type="submit" class="btn t-borde" data-enviar-diagnostico aria-label={c ? `Finalizar consulta con ${c.paciente}` : undefined}>Guardar diagnóstico y finalizar</button>
  </form>
</li>
