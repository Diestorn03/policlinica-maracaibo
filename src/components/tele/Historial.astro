---
// Consultas ya terminadas, en una tabla con líneas (en el teléfono, cada fila es un bloque). Las activas viven arriba, en el bloque azul.
// Las fechas de SQLite vienen en UTC: se muestran en hora de Maracaibo.
import { duracion, fechaCaracas } from '../../lib/sitio';
import type { Pasada } from '../../lib/tele';

interface Props { items: Pasada[]; rol: 'cliente' | 'medico' }
const { items, rol } = Astro.props;
const cliente = rol === 'cliente';
const filas = items.filter((i) => i.estado === 'finalizada' || i.estado === 'cancelada');
const quien = cliente ? 'Médico' : 'Paciente';
---
<section class="t-hoja" aria-labelledby="t-hist">
  <h2 id="t-hist">{cliente ? 'Tus consultas' : 'Consultas que has atendido'}</h2>
  {filas.length === 0 ? (
    <p class="t-vacio">{cliente ? 'Todavía no tienes consultas por videollamada. Cuando las tengas, aparecerán aquí.' : 'Todavía no has atendido consultas.'}</p>
  ) : (
    <table class="t-tabla">
      <caption class="sr-only">{cliente ? 'Tus consultas por videollamada' : 'Consultas que has atendido por videollamada'}</caption>
      <thead><tr><th scope="col">Fecha</th><th scope="col">Hora</th><th scope="col">{quien}</th><th scope="col">Diagnóstico</th><th scope="col">Duración</th><th scope="col">Estado</th></tr></thead>
      <tbody>
        {filas.map((i) => {
          const min = i.atendida ? duracion(i.atendida, i.finalizada) : null;
          const diagnostico = i.diagnostico || (i.estado === 'finalizada' ? 'Sin diagnóstico registrado' : '—');
          return (
            <tr>
              <td data-etiqueta="Fecha">{fechaCaracas(i.creada)}</td>
              <td data-etiqueta="Hora">{fechaCaracas(i.creada, 'hora')}</td>
              <td data-etiqueta={quien}>{(cliente ? i.medico : i.paciente) || 'Sin médico'}</td>
              <td data-etiqueta="Diagnóstico">{diagnostico}</td>
              <td data-etiqueta="Duración">{min == null ? '—' : `${min} min`}</td>
              <td data-etiqueta="Estado">{i.estado === 'finalizada' ? 'Finalizada' : 'Sin atender'}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  )}
</section>
