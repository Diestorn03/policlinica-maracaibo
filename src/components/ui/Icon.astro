interface Props { name: IconName; size?: number; label?: string; class?: string }
const { name, size = 22, label, class: cls } = Astro.props;
---
<svg
  class:list={['icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={PATHS[name]}
/>
