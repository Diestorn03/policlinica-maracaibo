---
// Tarjeta de médico (directorio y portada). Sin foto: la imagen de la web oficial (SIN_FOTO, el logo de la clínica).
// data-clave y data-esp sirven al filtro del navegador (directorio estático en la demo).
import Icon from './Icon.astro';
import { u } from '../../lib/entorno';
import { SIN_FOTO, telHref } from '../../lib/sitio';
import { clave, type Medico } from '../../lib/db';

interface Props { medico: Medico; lazy?: boolean }
const { medico: m, lazy = true } = Astro.props;
const busca = clave([m.nombre, ...m.especialidades.map((e) => e.nombre)].join(' '));
---
<article class="medico" data-clave={busca} data-esp={m.especialidades.map((e) => e.slug).join(' ')}>
  <div class="medico__foto">
    <img src={u(m.foto || SIN_FOTO)} alt={m.foto ? `Foto de ${m.nombre}` : ''} width="480" height="480" loading={lazy ? 'lazy' : 'eager'} decoding="async" />
  </div>
  <div class="medico__body">
    <h3 class="medico__nombre">{m.nombre}</h3>
    <ul class="medico__esps">{m.especialidades.map((e) => <li><a class="pill" href={u(`/directorio/?esp=${e.slug}`)}>{e.nombre}</a></li>)}</ul>
    {m.consultorio && <p class="medico__dato"><Icon name="pin" size={16} /> {/consultorio/i.test(m.consultorio) ? m.consultorio : `Consultorio ${m.consultorio}`}</p>}
    {m.telefono && <a class="medico__tel" href={telHref(m.telefono)}><Icon name="phone" size={16} /> {m.telefono}</a>}
  </div>
</article>

<style>
  .medico { min-width: 0; background: #fff; border-radius: var(--radius); border: 1px solid var(--line); overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; transition: box-shadow .4s var(--ease-out), border-color .3s; }
  .medico:hover { box-shadow: var(--shadow); border-color: transparent; }
  .medico__foto { aspect-ratio: 1; background: var(--navy); display: grid; place-items: center; overflow: hidden; }
  .medico__foto img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out); }
  .medico:hover .medico__foto img { transform: scale(1.05); }
  /* el teléfono va al pie de la ficha: en una fila de fichas todos quedan a la misma altura */
  .medico__body { padding: 1.1rem 1.2rem 1.3rem; display: flex; flex-direction: column; align-items: flex-start; gap: .55rem; }
  .medico__tel { margin-top: auto; }
  /* en las tarjetas angostas (dos por fila en el teléfono) las palabras largas se parten con guion en vez de salirse */
  .medico__nombre { font-size: 1.05rem; hyphens: auto; overflow-wrap: break-word; }
  .medico__esps { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .35rem; }
  .medico__esps .pill { font-size: .8rem; max-width: 100%; hyphens: auto; overflow-wrap: anywhere; }
  .medico__dato, .medico__tel { display: inline-flex; align-items: center; gap: .4rem; font-size: .88rem; }
  .medico__tel { color: var(--blue); font-weight: 600; justify-self: start; }
  .medico__tel:hover { text-decoration: underline; }
  /* zona táctil de 44px sin agrandar el aspecto */
  .medico__esps .pill, .medico__tel { position: relative; }
  .medico__esps .pill::after, .medico__tel::after { content: ''; position: absolute; inset: -7px -2px; }
  .medico__tel::after { inset-block: -10px; }
</style>
