---
// /secretaria/ · alta acotada de clientes. La autorización de ruta vive en middleware y el servidor fuerza rol=cliente.
// Con un error no se redirige: la página vuelve con lo escrito (menos la contraseña) y marca solo el campo que falló.
export const prerender = false;
import Privado from '../../layouts/Privado.astro';
import { getDB, u, usuarioDe } from '../../lib/entorno';
import { PATRON_CEDULA, PATRON_TELEFONO, campoDelError, guardarUsuario, validarCliente } from '../../lib/usuarios';
import '../../styles/paginas/secretaria.css';

const yo = usuarioDe(Astro.locals, 'secretaria');
const aqui = u('/secretaria/');

let previo: FormData | null = null;
let fallo = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const datos = validarCliente(f);
  const creado = typeof datos === 'string' ? datos : await guardarUsuario(await getDB(), datos);
  if (typeof creado === 'number' && typeof datos !== 'string') return Astro.redirect(`${aqui}?ok=${encodeURIComponent(`${datos.nombre} quedó inscrito como cliente.`)}`, 303);
  previo = f;
  fallo = String(creado);
  Astro.response.status = 422;
}

const p = Astro.url.searchParams;
const error = fallo || p.get('error');
const campo = fallo ? campoDelError(fallo) : null;
const v = (k: string) => String(previo?.get(k) ?? '');
// el campo que falló: marcado, descrito por el aviso y con el foco
const marca = (k: string) => (campo === k ? { 'aria-invalid': 'true', 'aria-describedby': 'aviso-error', autofocus: true } : {});
const hoy = new Date().toISOString().slice(0, 10);
---
<Privado titulo="Inscribir cliente" zona="Secretaría" usuario={yo}>
  <section class="registro" aria-labelledby="registro-t">
    <header class="registro__cab">
      <p class="registro__eyebrow">Inscripción de afiliados</p>
      <h1 id="registro-t">Registrar un nuevo cliente</h1>
      <p>Esta cuenta podrá entrar al panel de cliente y a la sala de espera de telemedicina. No tienes acceso a historiales, médicos ni datos de otros clientes.</p>
    </header>

    {error && <p class="alert alert--error" id="aviso-error" role="alert">{error.slice(0, 240)}</p>}
    {p.get('ok') && <p class="alert alert--ok" role="status">{p.get('ok')!.slice(0, 240)}</p>}

    <form class="registro__form" method="post" action={aqui}>
      <div class="form-grid">
        <label class="campo"><span>Nombre completo</span><input class="input" name="nombre" required minlength="3" maxlength="120" autocomplete="name" autofocus={!campo} value={v('nombre')} {...marca('nombre')} /><small>Como aparecerá en su historial y en la sala de espera.</small></label>
        <label class="campo"><span>Cédula</span><input class="input" name="cedula" required maxlength="20" autocomplete="off" placeholder="V-12345678" pattern={PATRON_CEDULA} title="Por ejemplo V-12345678" value={v('cedula')} {...marca('cedula')} /><small>Obligatoria para los clientes.</small></label>
        <label class="campo"><span>Correo electrónico</span><input class="input" name="correo" type="email" required maxlength="120" autocomplete="email" value={v('correo')} {...marca('correo')} /></label>
        <label class="campo"><span>Teléfono</span><input class="input" name="telefono" type="tel" inputmode="tel" maxlength="40" autocomplete="tel" placeholder="0414-1234567" pattern={PATRON_TELEFONO} title="Solo números, espacios, guiones y paréntesis" value={v('telefono')} {...marca('telefono')} /></label>
        <label class="campo"><span>Fecha de nacimiento</span><input class="input" name="nacimiento" type="date" autocomplete="bday" max={hoy} value={v('nacimiento')} {...marca('nacimiento')} /></label>
        <label class="campo"><span>Afiliación vigente hasta</span><input class="input" name="afiliacion_vence" type="date" value={v('afiliacion_vence')} {...marca('afiliacion_vence')} /><small>Opcional. Una fecha vencida bloquea la telemedicina.</small></label>
        <label class="campo full"><span>Dirección</span><input class="input" name="direccion" maxlength="200" autocomplete="street-address" value={v('direccion')} /></label>
        <label class="campo full"><span>Contraseña inicial</span><input class="input" name="clave" type="password" required minlength="8" autocomplete="new-password" {...marca('clave')} /><small>Mínimo 8 caracteres. Entrégala al cliente de forma segura.{fallo && ' Por seguridad, escríbela de nuevo.'}</small></label>
      </div>
      <div class="registro__acciones">
        <button class="btn btn--primary" type="submit">Inscribir cliente</button>
      </div>
    </form>
  </section>
</Privado>

