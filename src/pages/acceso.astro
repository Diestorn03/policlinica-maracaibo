---
// Entrar: una sola pantalla para los tres roles; cada uno cae en su panel.
//  · Servidor: formulario real → POST /api/sesion. Con sesión abierta va directo a su panel. Mensajes: ?error=datos|limite, ?salio=1, ?volver=.
//  · Demo (GitHub Pages): no hay cuentas ni servidor; tres botones llevan a los paneles de ejemplo.
export const prerender = false;
import { Image } from 'astro:assets';
import Privado from '../layouts/Privado.astro';
import logo from '../assets/img/logo.png';
import { clinica } from '../data/site';
import { DEMO, u } from '../lib/entorno';
import { inicioDe } from '../lib/auth';
import { waHref } from '../lib/sitio';

if (Astro.locals.usuario) return Astro.redirect(inicioDe(Astro.locals.usuario.rol), 303);

const q = Astro.url.searchParams;
const volver = (q.get('volver') ?? '').slice(0, 200);
// Cada mensaje existe siempre (oculto): el servidor muestra el que toca y el script cubre la página estática o en caché
const avisos = [
  { id: 'datos', rol: 'alert', texto: 'No pudimos entrar con esos datos. Revisa tu correo o cédula y tu contraseña.', on: q.get('error') === 'datos' },
  { id: 'limite', rol: 'alert', texto: 'Hiciste demasiados intentos. Espera un minuto e inténtalo de nuevo.', on: q.get('error') === 'limite' },
  { id: 'salio', rol: 'status', texto: 'Cerraste tu sesión.', on: q.get('salio') === '1' },
];
const roles = [
  { href: '/admin/', titulo: 'Entrar como administrador', sub: 'Directorio médico, usuarios y consultas' },
  { href: '/medico/', titulo: 'Entrar como médico', sub: 'Sala de espera en vivo' },
  { href: '/panel/', titulo: 'Entrar como cliente', sub: 'Videollamada con un médico' },
  { href: '/secretaria/', titulo: 'Entrar como secretaria', sub: 'Inscripción de clientes afiliados' },
];
---
<Privado titulo="Entrar">
  <div class="acceso">
    <a class="acceso__logo" href={u('/')} aria-label={`${clinica.nombre}, ir al inicio`}><Image src={logo} alt="" height={44} /></a>

    <section class="acceso__hoja" aria-labelledby="acceso-t">
      <h1 id="acceso-t">{DEMO ? 'Elige un panel' : 'Entrar a tu panel'}</h1>

      {DEMO ? (
        <>
          <p>Esto es una demostración: los datos son de ejemplo y nada se guarda.</p>
          <div class="acceso__roles">
            {roles.map((r) => <a class="btn btn--primary btn--tarea" href={u(r.href)}>{r.titulo}<small>{r.sub}</small></a>)}
          </div>
        </>
      ) : (
        <form class="acceso__form" method="post" action={u('/api/sesion')} data-acceso>
          {avisos.map((a) => <p class="acceso__aviso" role={a.rol} tabindex="-1" data-aviso={a.id} hidden={!a.on}>{a.texto}</p>)}
          <input type="hidden" name="volver" value={volver} />
          <div class="acceso__campo">
            <label for="usuario">Correo o cédula</label>
            <input class="input" id="usuario" name="usuario" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required />
          </div>
          <div class="acceso__campo">
            <label for="clave">Contraseña</label>
            <div class="acceso__clave">
              <input class="input" id="clave" name="clave" type="password" autocomplete="current-password" required />
              <button class="acceso__ver js-solo" type="button" aria-controls="clave"><span data-ver>Mostrar</span><span class="sr-only"> la contraseña</span></button>
            </div>
          </div>
          <button class="btn btn--primary" type="submit" data-entrar>Entrar</button>
        </form>
      )}
    </section>

    <div class="acceso__ayuda">
      {!DEMO && <p>¿Olvidaste tu contraseña? <a class="link" href={waHref('Ayuda con mi acceso')} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>.</p>}
      <p>¿Quieres afiliarte? <a class="link" href={u('/afiliacion/')}>Conoce el plan de afiliación</a>.</p>
      <p>Emergencias: <a class="acceso__sos" href={clinica.emergencias.href}>{clinica.emergencias.texto}</a></p>
    </div>
  </div>

  <script>
    // Los mensajes de la URL (?error=…, ?salio=1) también en el navegador; el servidor ya pinta el suyo
    const f = document.querySelector<HTMLFormElement>('[data-acceso]');
    if (f) {
      const q = new URLSearchParams(location.search);
      const cual = q.get('salio') === '1' ? 'salio' : q.get('error');
      const aviso = [...f.querySelectorAll<HTMLElement>('[data-aviso]')].find((n) => n.dataset.aviso === cual);   // sin selector: ?error= puede traer comillas
      if (aviso) aviso.hidden = false;
      f.querySelector<HTMLElement>('[data-aviso]:not([hidden])')?.focus();

      // «Mostrar» la contraseña
      const clave = f.querySelector<HTMLInputElement>('#clave')!, ver = f.querySelector<HTMLElement>('[data-ver]')!;
      ver.closest('button')!.addEventListener('click', () => {
        const visible = clave.type === 'text';
        clave.type = visible ? 'password' : 'text';
        ver.textContent = visible ? 'Mostrar' : 'Ocultar';
      });

      // «Entrando…» al enviar (y se restablece si vuelven con «atrás»)
      const entrar = f.querySelector<HTMLElement>('[data-entrar]')!;
      f.addEventListener('submit', () => { entrar.setAttribute('aria-busy', 'true'); entrar.textContent = 'Entrando…'; });
      addEventListener('pageshow', (e) => { if (e.persisted) { entrar.removeAttribute('aria-busy'); entrar.textContent = 'Entrar'; } });
    }
  </script>
</Privado>

<style>
  /* Centrado y sin adorno: el logo, una hoja con el formulario y la ayuda. La barra del layout sobra aquí (el logo ya es el enlace al inicio). */
  :global(.app-bar) { display: none; }
  .acceso { width: min(26rem, 100%); margin-inline: auto; display: grid; gap: 1.75rem; justify-items: center; padding-top: clamp(.5rem, 4vh, 3rem); }
  .acceso__logo { display: block; line-height: 0; border-radius: 2px; }
  .acceso__logo :global(img) { height: 44px; width: auto; }
  .acceso__hoja { width: 100%; display: grid; gap: 1.25rem; padding: clamp(1.5rem, 5vw, 2.25rem); border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .acceso__hoja h1 { font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.25rem); letter-spacing: -.04em; }
  .acceso__form { display: grid; gap: 1.25rem; }
  .acceso__campo { display: grid; gap: .4rem; }
  .acceso__campo label { font: 600 .9375rem var(--font-head); color: var(--navy); }
  .acceso__campo .input { min-height: 54px; font-size: 1.0625rem; }
  .acceso__clave { position: relative; }
  .acceso__clave .input { padding-right: 6.5rem; }
  .acceso__ver { position: absolute; top: 5px; right: 5px; bottom: 5px; min-width: 5.5rem; padding: 0 .8rem; border: 0; border-radius: 999px; background: var(--mist); color: var(--navy); font: 600 .9375rem var(--font-head); cursor: pointer; }
  .acceso__ver:hover { background: #dfe3f6; }
  .acceso__form .btn { min-height: 56px; font-size: 1.05rem; }
  .acceso__aviso { margin: 0; text-wrap: wrap; padding: .85rem 1rem; border-radius: var(--radius); background: var(--mist); color: var(--navy); font-weight: 600; }
  :global(html:not(.js)) .js-solo { display: none; }   /* sin JS «Mostrar» no haría nada */
  .acceso__roles { display: grid; gap: .8rem; }
  .acceso__roles .btn { justify-content: center; }
  .acceso__ayuda { display: grid; gap: .5rem; justify-items: center; text-align: center; font-size: .9375rem; color: var(--navy); }   /* --muted no llega a 4.5:1 sobre el lavanda */
  .acceso__sos { color: var(--red); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
</style>
