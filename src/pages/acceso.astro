---
// Entrar: una sola pantalla para los tres roles; cada uno cae en su panel.
//  · Servidor: formulario real → POST /api/sesion. Con sesión abierta va directo a su panel. Mensajes: ?error=datos|limite, ?salio=1, ?volver=.
//  · Demo (GitHub Pages): no hay cuentas ni servidor; tres botones llevan a los paneles de ejemplo.
export const prerender = false;
import { Image } from 'astro:assets';
import Privado from '../layouts/Privado.astro';
import logo from '../assets/img/logo.png';
import { clinica } from '../data/site';
import { DEMO, u } from '../lib/entorno';
import { inicioDe } from '../lib/auth';
import { waHref } from '../lib/sitio';

if (Astro.locals.usuario) return Astro.redirect(inicioDe(Astro.locals.usuario.rol), 303);

const q = Astro.url.searchParams;
const volver = (q.get('volver') ?? '').slice(0, 200);
// Cada mensaje existe siempre (oculto): el servidor muestra el que toca y el script cubre la página estática o en caché
const avisos = [
  { id: 'datos', rol: 'alert', texto: 'No pudimos entrar con esos datos. Revisa tu correo o cédula y tu contraseña.', on: q.get('error') === 'datos' },
  { id: 'limite', rol: 'alert', texto: 'Hiciste demasiados intentos. Espera un minuto e inténtalo de nuevo.', on: q.get('error') === 'limite' },
  { id: 'salio', rol: 'status', texto: 'Cerraste tu sesión.', on: q.get('salio') === '1' },
];
const roles = [
  { href: '/admin/', titulo: 'Entrar como administrador', sub: 'Directorio médico, usuarios y consultas' },
  { href: '/medico/', titulo: 'Entrar como médico', sub: 'Sala de espera en vivo' },
  { href: '/panel/', titulo: 'Entrar como cliente', sub: 'Videollamada con un médico' },
  { href: '/secretaria/', titulo: 'Entrar como secretaria', sub: 'Inscripción de clientes afiliados' },
];
import '../styles/paginas/acceso.css';
---
<Privado titulo="Entrar">
  <div class="acceso">
    <a class="acceso__logo" href={u('/')} aria-label={`${clinica.nombre}, ir al inicio`}><Image src={logo} alt="" height={44} densities={[1, 2]} /></a>

    <section class="acceso__hoja" aria-labelledby="acceso-t">
      <h1 id="acceso-t">{DEMO ? 'Elige un panel' : 'Entrar a tu panel'}</h1>

      {DEMO ? (
        <>
          <p>Esto es una demostración: los datos son de ejemplo y nada se guarda.</p>
          <div class="acceso__roles">
            {roles.map((r) => <a class="btn btn--primary btn--tarea" href={u(r.href)}>{r.titulo}<small>{r.sub}</small></a>)}
          </div>
        </>
      ) : (
        <form class="acceso__form" method="post" action={u('/api/sesion')} data-acceso>
          {avisos.map((a) => <p class="acceso__aviso" role={a.rol} tabindex="-1" data-aviso={a.id} hidden={!a.on}>{a.texto}</p>)}
          <input type="hidden" name="volver" value={volver} />
          <div class="acceso__campo">
            <label for="usuario">Correo o cédula</label>
            <input class="input" id="usuario" name="usuario" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required />
          </div>
          <div class="acceso__campo">
            <label for="clave">Contraseña</label>
            <div class="acceso__clave">
              <input class="input" id="clave" name="clave" type="password" autocomplete="current-password" required />
              <button class="acceso__ver js-solo" type="button" aria-controls="clave"><span data-ver>Mostrar</span><span class="sr-only"> la contraseña</span></button>
            </div>
          </div>
          <button class="btn btn--primary" type="submit" data-entrar>Entrar</button>
        </form>
      )}
    </section>

    <div class="acceso__ayuda">
      {!DEMO && <p>¿Olvidaste tu contraseña? <a class="link" href={waHref('Ayuda con mi acceso')} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>.</p>}
      <p>¿Quieres afiliarte? <a class="link" href={u('/afiliacion/')}>Conoce el plan de afiliación</a>.</p>
      <p>Emergencias: <a class="acceso__sos" href={clinica.emergencias.href}>{clinica.emergencias.texto}</a></p>
    </div>
  </div>

  <script>
    import '../scripts/paginas/acceso.ts';
  </script>
</Privado>

