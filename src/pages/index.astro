---
// Portada. Una sola apuesta, sacada del mundo real de la clínica: sus médicos y su edificio.
//  · Héroe: la cruz del logo armada con retratos reales (único momento orquestado de la página).
//  · El edificio, piso por piso: dónde atiende cada médico (la cabina del «+» recorre los pisos con el scroll).
//  · Todo lo demás, quieto y en el tono del sitio actual. Lee la base con getDB() en los dos modos.
export const prerender = false;
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/ui/Icon.astro';
import { getDB, u } from '../lib/entorno';
import { especialidades, medicos, resumen, retratosDelDia, type Medico } from '../lib/db';
import { afiliacion, anos, clinica, servicios, testimonios } from '../data/site';
import { iniciales, miniatura, PISOS, telHref, ubicacion, waHref, type Piso } from '../lib/sitio';
import entrada from '../assets/img/inst-3.jpg';
import accesoEmergencia from '../assets/img/inst-5.jpg';

const db = await getDB();
const [res, esps, todos, caras] = await Promise.all([resumen(db), especialidades(db), medicos(db), retratosDelDia(db, 16)]);

// La cruz: brazos de 2 de 6 celdas (proporción del «+» del logo); anillo 1 alrededor del sello, anillo 2 en las puntas
const CELDAS = [[1, 2], [1, 3], [2, 4], [3, 4], [4, 3], [4, 2], [3, 1], [2, 1], [0, 2], [0, 3], [2, 5], [3, 5], [5, 3], [5, 2], [3, 0], [2, 0]];
const cruz = caras.slice(0, CELDAS.length).map((m, i) => ({ m, r: CELDAS[i][0], c: CELDAS[i][1], anillo: i < 8 ? 1 : 2 }));
const especialidadDe = (m: Medico) => m.especialidades.map((e) => e.nombre).join(', ');

// El edificio: médicos agrupados por piso y puertas (consultorios) de cada piso
type Fila = { m: Medico; puertas: string[]; donde: string };
const porPiso = new Map<Piso, Fila[]>(PISOS.map((p) => [p.id, []]));
for (const m of todos) {
  const ub = ubicacion(m.consultorio);
  if (ub.piso) porPiso.get(ub.piso)!.push({ m, puertas: ub.puertas, donde: ub.puertas.length ? `consultorio ${ub.puertas.join(', ')}` : ub.texto.split(', ').slice(1).join(', ') });
}
const orden = (a: string, b: string) => parseInt(a) - parseInt(b) || a.localeCompare(b);
const edificio = PISOS.map((p) => {
  const filas = porPiso.get(p.id)!;
  const puertas = [...new Set(filas.flatMap((f) => f.puertas))].sort(orden);
  return { ...p, filas, puertas, cuenta: (d: string) => filas.filter((f) => f.puertas.includes(d)).length };
});

const estudios = ['tomografia', 'rayos-x', 'laboratorio', 'video-endoscopia'].map((s) => servicios.find((x) => x.slug === s)!);
const unidades = [
  { s: 'cirugia', texto: 'Operaciones electivas y de urgencia.' },
  { s: 'uci', texto: 'Medicina crítica, con banco de sangre, laboratorio y radiología las 24 horas.' },
  { s: 'cirugia-bariatrica', texto: 'Un equipo coordinado de especialistas, psicólogos y nutricionistas.' },
  { s: 'obstetrica-neonatal', texto: 'Atención durante el embarazo, el parto y el puerperio.' },
].map((x) => ({ ...x, ...servicios.find((y) => y.slug === x.s)! }));
const notaEstudio: Record<string, string> = {
  tomografia: '7:00 a. m. a 5:00 p. m. Algunos estudios requieren cita previa.',
  'rayos-x': '7:00 a. m. a 5:00 p. m. Algunos estudios requieren cita previa.',
  laboratorio: '7:00 a. m. a 5:00 p. m. Emergencias las 24 horas.',
  'video-endoscopia': 'Lunes a viernes, de 8:00 a. m. a 2:00 p. m.',
};
const mapa = 'https://maps.google.com/maps?q=Policl%C3%ADnica%20Maracaibo%2C%20Av.%208%20Santa%20Rita%2C%20Maracaibo&z=16&output=embed';
---
<Layout titulo={`${clinica.nombre}, atención médica desde ${clinica.desde}`}>
  <!-- Héroe -->
  <section class="hero" id="hero">
    <div class="wrap hero__grid">
      <div class="hero__texto">
        <h1 class="h-display">Atención médica en Maracaibo desde {clinica.desde}</h1>
        <p class="lead">{res.medicos} médicos de {res.especialidades} especialidades, laboratorio, estudios por imágenes y emergencias las 24 horas, en la {clinica.direccion}.</p>
        <div class="hero__tareas">
          <a class="btn btn--sos btn--tarea" href={clinica.emergencias.href}>Llamar a emergencias <small>{clinica.emergencias.texto}</small></a>
          <a class="btn btn--primary btn--tarea" href={waHref()} target="_blank" rel="noopener">Pedir cita por WhatsApp <small>Lunes a viernes, 8:00 a. m. a 4:00 p. m.</small></a>
        </div>
        <a class="link hero__buscar" href="#pisos">Buscar un médico</a>
      </div>

      <figure class="cruz">
        <div class="cruz__grid">
          {cruz.map(({ m, r, c, anillo }) => (
            <a class="cruz__t" href={u(`/directorio/?q=${encodeURIComponent(m.nombre.replace(/^Dra?\. /, ''))}`)} data-anillo={anillo} data-r={r} data-c={c}
              style={`grid-area:${r + 1}/${c + 1}`} aria-label={`${m.nombre}, ${especialidadDe(m)}`} data-quien={`${m.nombre}, ${especialidadDe(m).toLowerCase()}`}>
              <img src={u(miniatura(m.foto))} alt="" width="160" height="160" decoding="async" />
            </a>
          ))}
          <div class="cruz__sello" aria-hidden="true"><b>{anos()}</b><span>años</span></div>
        </div>
        <figcaption aria-live="polite">Algunos de nuestros {res.medicos} médicos</figcaption>
      </figure>
    </div>
  </section>

  <!-- El edificio, piso por piso -->
  <section class="edificio" id="pisos" aria-labelledby="pisos-t">
    <div class="edificio__escena">
      <div class="wrap edificio__grid">
        <div class="edificio__head">
          <h2 class="h-xl" id="pisos-t">Encuentra el piso y el consultorio de tu médico</h2>
          <p>Elige un piso para ver sus consultorios, o escribe el nombre del médico o la especialidad.</p>
          <form class="buscador" action={u('/directorio/')} method="get" role="search">
            <label class="sr-only" for="q">Nombre del médico o especialidad</label>
            <Icon name="search" />
            <input id="q" name="q" type="search" placeholder="Médico o especialidad" autocomplete="off" />
            <button class="btn btn--sm btn--white" type="submit">Buscar</button>
          </form>
        </div>

        <div class="torre">
          <div class="torre__riel" aria-hidden="true"><span class="torre__cabina"><Icon name="cross" size={22} /></span></div>
          <ol class="pisos">
            {edificio.map((p) => (
              <li class="piso" data-piso={p.id}>
                <button class="piso__nombre" type="button" aria-controls={`hoja-${p.id}`}>{p.nombre}<small>{p.filas.length} {p.filas.length === 1 ? 'médico' : 'médicos'}</small></button>
                <ul class="puertas">
                  {p.puertas.map((d, i) => (
                    <li><button class="puerta" type="button" data-puerta={d} style={`--i:${i}`} aria-label={`Consultorio ${d}, ${p.nombre}, ${p.cuenta(d)} ${p.cuenta(d) === 1 ? 'médico' : 'médicos'}`}>{d}</button></li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </div>

        <div class="hoja" data-lenis-prevent>
          {edificio.map((p) => (
            <details class="hoja__piso" id={`hoja-${p.id}`} data-piso={p.id} open>
              <summary><span>{p.nombre}</span><small>{p.filas.length} {p.filas.length === 1 ? 'médico' : 'médicos'} en {p.puertas.length} {p.puertas.length === 1 ? 'consultorio' : 'consultorios'}</small><i class="mas" aria-hidden="true"></i></summary>
              <ul class="hoja__lista">
                {p.filas.map(({ m, puertas, donde }) => (
                  <li data-puertas={puertas.join(' ')}>
                    {m.foto ? <img src={u(miniatura(m.foto))} alt="" width="56" height="56" loading="lazy" decoding="async" /> : <span class="ini" aria-hidden="true">{iniciales(m.nombre)}</span>}
                    <div>
                      <b>{m.nombre}</b>
                      <span>{especialidadDe(m)}{donde && `, ${donde}`}</span>
                      {m.telefono && <a href={telHref(m.telefono)}>{m.telefono}</a>}
                    </div>
                  </li>
                ))}
              </ul>
            </details>
          ))}
          <p class="hoja__mas"><a class="link" href={u('/directorio/')}>Ver los {res.medicos} médicos en el directorio</a></p>
        </div>
      </div>
      <details class="wrap edificio__esps">
        <summary>Ver las {res.especialidades} especialidades</summary>
        <ul>{esps.map((e) => <li><a href={u(`/directorio/?esp=${e.slug}`)}>{e.nombre}</a></li>)}</ul>
      </details>
    </div>
  </section>

  <!-- Servicios -->
  <section class="section servicios" id="servicios">
    <div class="wrap">
      <h2 class="h-xl servicios__t">Estudios, cirugía y cuidados intensivos en un mismo edificio</h2>
      <h3 class="h-lg">Estudios y diagnóstico</h3>
      <ul class="estudios">
        {estudios.map((s) => (
          <li>
            <a href={u(`/servicios/${s.slug}/`)}>
              <span class="estudios__nombre">{s.nombre}</span>
              <span class="estudios__nota">{notaEstudio[s.slug]}</span>
              <Image class="estudios__foto" src={s.imagen} alt={s.alt} widths={[240, 360]} sizes="180px" style={`object-position:${s.pos}`} />
            </a>
          </li>
        ))}
      </ul>
      <h3 class="h-lg">Cirugía y unidades especializadas</h3>
      <ul class="unidades">
        {unidades.map((s) => (
          <li>
            <a href={u(`/servicios/${s.slug}/`)}>
              <Image src={s.imagen} alt={s.alt} widths={[360, 560]} sizes="(max-width: 960px) 50vw, 25vw" style={`object-position:${s.pos}`} />
              <span class="unidades__nombre">{s.nombre}</span>
              <span>{s.texto}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="servicios__esp"><b>Especialidades</b> {res.especialidades} especialidades con médicos en el directorio. <a class="link" href={u('/especialidades/')}>Ver las especialidades</a></p>
    </div>
  </section>

  <!-- Afiliación -->
  <section class="section afiliacion">
    <div class="wrap afiliacion__grid">
      <div>
        <h2 class="h-xl">{afiliacion.idea.replace(/\.$/, '')}</h2>
        <p class="afiliacion__precio">Consulta el precio por WhatsApp.</p>
        <ul class="afiliacion__incluye">{afiliacion.incluye.map((i) => <li>{i}</li>)}</ul>
        <div class="cta-row">
          <a class="btn btn--white" href={afiliacion.cta.href} target="_blank" rel="noopener">{afiliacion.cta.texto}</a>
          <a class="afiliacion__link" href={u('/afiliacion/')}>Cómo funciona la afiliación</a>
        </div>
      </div>
      <div>
        <h3 class="h-lg">Así es una consulta por videollamada</h3>
        <ol class="pasos">
          <li>Entra a tu panel con tu usuario y tu clave.</li>
          <li>Pulsa «Entrar a la videollamada» y espera en la sala de espera.</li>
          <li>Cuando un médico te atienda, se abre la videollamada.</li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 74 años y testimonios -->
  <section class="section aniversario">
    <div class="wrap aniversario__grid">
      <h2 class="aniversario__t">{anos()} años celebrando tu bienestar</h2>
      <div>
        <ul class="citas">{testimonios.map((t) => <li><blockquote>«{t.texto}»</blockquote></li>)}</ul>
        <p class="aniversario__pie">Comentarios de pacientes y doctores.</p>
      </div>
    </div>
  </section>

  <!-- Cómo llegar -->
  <section class="section llegar" id="como-llegar">
    <div class="wrap llegar__grid">
      <div>
        <h2 class="h-xl">Estamos en la {clinica.direccion}</h2>
        <dl class="numeros">
          <div><dt>Emergencias</dt><dd><a class="numeros__n numeros__n--sos" href={clinica.emergencias.href}>{clinica.emergencias.texto}</a><span>Todos los días, a toda hora</span></dd></div>
          <div><dt>Citas por WhatsApp</dt><dd><a class="numeros__n" href={waHref()} target="_blank" rel="noopener">{clinica.whatsapp.texto}</a><span>Lunes a viernes, de 8:00 a. m. a 4:00 p. m.</span></dd></div>
          <div><dt>Central</dt><dd><a class="numeros__n" href={clinica.telefono.href}>{clinica.telefono.texto}</a></dd></div>
          <div><dt>Correo</dt><dd><a class="link" href={`mailto:${clinica.correo}`}>{clinica.correo}</a></dd></div>
        </dl>
      </div>
      <div class="llegar__lugar">
        <div class="mapa"><iframe src={mapa} title="Mapa: Policlínica Maracaibo, Av. 8 Santa Rita" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
        <a class="link" href={clinica.mapa} target="_blank" rel="noopener">Abrir en Google Maps</a>
        <div class="llegar__fotos">
          <figure><Image src={accesoEmergencia} alt="Fachada de la Policlínica con el letrero de Emergencia" widths={[360, 560]} sizes="(max-width: 960px) 50vw, 22vw" /><figcaption>Acceso a Emergencia</figcaption></figure>
          <figure><Image src={entrada} alt="Entrada de la Policlínica con bancas de concreto y palmas" widths={[360, 560]} sizes="(max-width: 960px) 50vw, 22vw" /><figcaption>La entrada</figcaption></figure>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { gsap, ScrollTrigger, reduced, getLenis } from '../scripts/motion.js';

  /* ---------- La cruz de los médicos: se arma una vez al cargar ---------- */
  const cruz = document.querySelector('.cruz');
  const nota = cruz?.querySelector('figcaption');
  if (cruz && nota) {
    const tiles = [...cruz.querySelectorAll<HTMLElement>('.cruz__t')];
    const sello = cruz.querySelector('.cruz__sello');
    const ancho = matchMedia('(min-width: 1101px)').matches;
    if (!reduced) {
      // desde el centro de la cruz hacia su celda
      gsap.set(tiles, { xPercent: (_, el) => (2.5 - +el.dataset.c) * 105, yPercent: (_, el) => (2.5 - +el.dataset.r) * 105, scale: ancho ? 0.6 : 1, opacity: 0 });
      gsap.set(sello, { scale: 0, opacity: 0 });
    }
    document.documentElement.classList.add('cruz-lista');
    const k = ancho ? 1 : 0.8;
    const listo = Promise.race([Promise.all(tiles.slice(0, 8).map((t) => t.querySelector('img')!.decode().catch(() => {}))), new Promise((r) => setTimeout(r, 900))]);
    if (!reduced) listo.then(() => gsap.timeline({ onComplete: () => gsap.set([...tiles, sello], { clearProps: 'transform,opacity' }) })
      .to(sello, { scale: 1, opacity: 1, duration: 0.6 * k, ease: 'back.out(1.5)' }, 0)
      .to(tiles.filter((t) => t.dataset.anillo === '1'), { xPercent: 0, yPercent: 0, scale: 1, opacity: 1, duration: 0.9 * k, ease: 'power4.out', stagger: 0.04 }, 0.3 * k)
      .to(tiles.filter((t) => t.dataset.anillo === '2'), { xPercent: 0, yPercent: 0, scale: 1, opacity: 1, duration: 1 * k, ease: 'power4.out', stagger: 0.04 }, 0.5 * k));
    // al pasar o enfocar una cara, el pie dice quién es
    const original = nota.textContent;
    tiles.forEach((t) => {
      const ver = () => (nota.textContent = t.dataset.quien!);
      t.addEventListener('pointerenter', ver);
      t.addEventListener('focus', ver);
      t.addEventListener('pointerleave', () => (nota.textContent = original));
      t.addEventListener('blur', () => (nota.textContent = original));
    });
  }

  /* ---------- El edificio: la cabina recorre los pisos con el scroll (escritorio) ---------- */
  const sec = document.querySelector<HTMLElement>('.edificio');
  if (sec) {
    const pisos = [...sec.querySelectorAll<HTMLElement>('.piso')];
    const hojas = [...sec.querySelectorAll<HTMLDetailsElement>('.hoja__piso')];
    const cabina = sec.querySelector<HTMLElement>('.torre__cabina')!;
    const riel = sec.querySelector<HTMLElement>('.torre__riel')!;
    const filas = [...sec.querySelectorAll<HTMLElement>('.hoja__lista li')];
    let act = -1;
    const activar = (i: number) => {
      if (i === act) return;
      act = i;
      pisos.forEach((p, j) => p.classList.toggle('is-on', j === i));
      hojas.forEach((h, j) => h.classList.toggle('is-on', j === i));
      const p = pisos[i];
      const y = p.getBoundingClientRect().top - riel.getBoundingClientRect().top + p.offsetHeight / 2 - cabina.offsetHeight / 2;
      gsap.to(cabina, { y, duration: 0.7, ease: 'power3.inOut' });
    };
    const elegirPuerta = (d: string | null) => {
      sec.querySelectorAll('.puerta').forEach((b) => b.classList.toggle('is-sel', (b as HTMLElement).dataset.puerta === d && b.closest('.piso')!.classList.contains('is-on')));
      filas.forEach((f) => f.classList.toggle('is-tenue', !!d && !(f.dataset.puertas ?? '').split(' ').includes(d)));
    };

    const mm = gsap.matchMedia();
    mm.add('(min-width: 1101px) and (prefers-reduced-motion: no-preference)', () => {
      sec.classList.add('edificio--vivo');
      ScrollTrigger.refresh();
      const st = ScrollTrigger.create({
        trigger: sec, start: 'top top', end: 'bottom bottom',
        onUpdate: (s) => { const i = Math.min(pisos.length - 1, Math.floor(s.progress * pisos.length)); if (i !== act) { activar(i); elegirPuerta(null); } },
      });
      activar(0);
      const irA = (i: number, puerta: string | null = null) => {
        const y = st.start + ((i + 0.5) / pisos.length) * (st.end - st.start);
        const lenis = getLenis();
        lenis ? lenis.scrollTo(y, { duration: 0.9 }) : scrollTo({ top: y, behavior: 'smooth' });
        activar(i);
        elegirPuerta(puerta);
      };
      const onClick = (e: Event) => {
        const b = (e.target as HTMLElement).closest('button');
        if (!b) return;
        const i = pisos.indexOf(b.closest('.piso') as HTMLElement);
        if (i >= 0) irA(i, b.dataset.puerta ?? null);
      };
      sec.addEventListener('click', onClick);
      return () => { sec.classList.remove('edificio--vivo'); sec.removeEventListener('click', onClick); st.kill(); act = -1; };
    });
    // móvil o movimiento reducido: un piso abierto a la vez; tocar un piso de la torre abre su hoja
    mm.add('(max-width: 1100px), (prefers-reduced-motion: reduce)', () => {
      hojas.forEach((h) => (h.open = false));
      const onClick = (e: Event) => {
        const b = (e.target as HTMLElement).closest('button');
        const p = b?.closest('.piso') as HTMLElement | null;
        if (!b || !p) return;
        const h = hojas[pisos.indexOf(p)];
        h.open = true;
        h.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        elegirPuerta(b.dataset.puerta ?? null);
      };
      sec.addEventListener('click', onClick);
      return () => sec.removeEventListener('click', onClick);
    });
  }
</script>

<style>
  /* ---------- héroe ---------- */
  .hero { background: var(--mist); }
  .hero__grid { display: grid; grid-template-columns: 1.25fr .75fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-block: clamp(3rem, 6vw, 5rem); }
  .hero__texto { display: grid; gap: 1.5rem; justify-items: start; }
  .hero__texto h1 { font-size: clamp(2.5rem, 1.5rem + 3.4vw, 4.1rem); max-width: 15ch; }
  .hero__tareas { display: flex; flex-wrap: wrap; gap: .8rem; }
  .hero__buscar { font-size: 1.05rem; }

  .cruz { margin: 0; width: min(440px, 100%); justify-self: center; display: grid; gap: .9rem; }
  .cruz__grid { display: grid; grid-template: repeat(6, 1fr) / repeat(6, 1fr); gap: clamp(4px, .6vw, 7px); aspect-ratio: 1; }
  .cruz__t { display: block; border-radius: var(--r-foto); overflow: hidden; background: var(--navy); outline-offset: 2px; }
  .cruz__t img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; transition: transform .4s var(--ease-out); }
  .cruz__t:hover img, .cruz__t:focus-visible img { transform: scale(1.08); }
  .cruz__sello { grid-area: 3 / 3 / 5 / 5; display: grid; place-content: center; text-align: center; background: var(--gold); color: var(--navy); border-radius: var(--r-foto); font: 700 clamp(.8rem, 1.3vw, 1rem) / 1 var(--font-head); }
  .cruz__sello b { font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 800; line-height: .9; }
  .cruz figcaption { text-align: center; font-size: .9375rem; color: var(--muted); min-height: 1.6em; }
  :global(html.js:not(.cruz-lista)) :is(.cruz__t, .cruz__sello) { opacity: 0; }

  /* ---------- el edificio ---------- */
  .edificio { background: var(--navy-deep); color: #c9d3ea; }
  .edificio__escena { padding-block: clamp(4rem, 8vw, 6rem); }
  .edificio__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); grid-template-areas: 'head head' 'torre hoja'; gap: 2.5rem 3rem; }
  .edificio__head { grid-area: head; display: grid; gap: 1rem; grid-template-columns: 1fr auto; align-items: end; }
  .edificio__head h2 { color: #fff; max-width: 18ch; }
  .edificio__head p { grid-column: 1; max-width: 52ch; }
  .buscador { grid-column: 2; grid-row: 1 / 3; align-self: end; display: flex; align-items: center; gap: .6rem; width: min(440px, 100%); padding: .35rem .35rem .35rem 1rem; border-radius: 999px; background: #fff; color: var(--muted); }
  .buscador input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; min-height: 46px; color: var(--ink); }
  .buscador:focus-within { box-shadow: 0 0 0 3px var(--sky); }
  .buscador .btn--white { background: var(--blue); color: #fff; }

  .torre { grid-area: torre; display: grid; grid-template-columns: 52px 1fr; gap: 1.2rem; align-self: start; }
  .torre__riel { position: relative; border-left: 2px dashed #3a4a75; margin-left: 25px; }
