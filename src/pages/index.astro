  .edificio:global(.edificio--vivo) .mas { display: none; }

  /* ---------- servicios ---------- */
  .servicios__t { max-width: 22ch; margin-bottom: 2.5rem; }
  .servicios h3 { margin-bottom: 1rem; }
  .estudios { list-style: none; margin: 0 0 3.5rem; padding: 0; border-top: 1px solid var(--line); }
  .estudios a { display: grid; grid-template-columns: 15rem 1fr 180px; gap: 1.5rem; align-items: center; padding: 1rem .8rem; border-bottom: 1px solid var(--line); transition: background .2s; }
  .estudios a:hover { background: var(--mist); }
  .estudios__nombre { font: 600 1.3125rem var(--font-head); letter-spacing: -.02em; color: var(--blue); text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1.5px; }
  .estudios__foto { display: block; width: 180px; height: 120px; border-radius: var(--r-foto); overflow: hidden; }
  .estudios__foto :global(img), .unidades__foto :global(img), .llegar__foto :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease-out); }
  .estudios a:hover .estudios__foto :global(img), .unidades a:hover .unidades__foto :global(img) { transform: scale(1.05); }
  /* cuatro tarjetas iguales y alineadas: cada una ocupa tres filas de la cuadrícula (foto, nombre, texto) con subgrid,
     así los nombres y los textos empiezan a la misma altura aunque un nombre ocupe dos líneas */
  .unidades { list-style: none; margin: 0 0 1.5rem; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 1.5rem; }
  .unidades li { display: grid; grid-row: span 3; grid-template-rows: subgrid; padding-bottom: 1.5rem; }
  .unidades a { grid-row: span 3; display: grid; grid-template-rows: subgrid; }
  .unidades__foto { display: block; aspect-ratio: 4 / 3; border-radius: var(--r-foto); overflow: hidden; margin-bottom: 1rem; }
  .unidades__nombre { align-self: start; margin-bottom: .45rem; font: 600 1.15rem/1.3 var(--font-head); letter-spacing: -.02em; color: var(--blue); text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1.5px; }
  .unidades a:hover .unidades__nombre { text-decoration-thickness: 2.5px; }
  .servicios__esp { padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: 1.0625rem; }
  .servicios__esp b { font-family: var(--font-head); font-weight: 600; color: var(--navy); margin-right: .6rem; }
  .servicios__esp .link { white-space: nowrap; }

  /* ---------- afiliación: degradado azul de marca (como las tarjetas de ExpertsDDT) ---------- */
  .afiliacion { overflow: hidden; isolation: isolate; background: linear-gradient(135deg, var(--blue) 0%, #12306f 55%, var(--navy) 100%); color: #dfe8fb; }
  .afiliacion :is(h2, h3) { color: #fff; }
  .afiliacion__grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 6vw, 6rem); }
  .afiliacion__grid > div { display: grid; gap: 1.4rem; align-content: start; }
  .afiliacion__precio { font: 600 1.15rem var(--font-head); color: #fff; }
  .afiliacion__incluye { list-style: none; margin: 0; padding: 0; }
  .afiliacion__incluye li { padding-block: .8rem; border-top: 1px solid rgba(255, 255, 255, .22); }
  .afiliacion__incluye li:last-child { border-bottom: 1px solid rgba(255, 255, 255, .22); }
  .afiliacion__link { color: #fff; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--sky); }
  .pasos { list-style: none; margin: 0; padding: 0; counter-reset: paso; }
  .pasos li { counter-increment: paso; display: grid; grid-template-columns: 4.5rem 1fr; align-items: baseline; padding-block: 1.1rem; border-top: 1px solid rgba(255, 255, 255, .22); font-size: 1.125rem; color: #fff; }
  .pasos li::before { content: counter(paso, decimal-leading-zero); font: 300 2.6rem/1 var(--font-head); letter-spacing: -.04em; color: #8fd0ff; }

  /* ---------- años y testimonios ---------- */
  .aniversario { background: #fff; }
  .aniversario__grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .aniversario__t { font-size: clamp(2.2rem, 1.3rem + 3.2vw, 4rem); font-weight: 500; line-height: 1.04; letter-spacing: -.045em; color: var(--navy); max-width: 11ch; }
  .aniversario__t span { display: block; font-weight: 700; color: var(--blue); }
