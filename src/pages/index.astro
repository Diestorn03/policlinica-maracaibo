---
// Portada: la estructura del sitio actual (héroe, servicios, «tu cita en un click», testimonios, contacto) con la marca
// de siempre y movimiento de motion.js. Lee la base con getDB(): bajo demanda en el servidor, al compilar en la demo.
export const prerender = false;
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import MedicoCard from '../components/ui/MedicoCard.astro';
import { getDB, u } from '../lib/entorno';
import { especialidades, resumen, retratosDelDia } from '../lib/db';
import { afiliacion, anos, clinica, indiceServicios, testimonios } from '../data/site';
import { waHref } from '../lib/sitio';
import fachada from '../assets/img/inst-3.jpg';
import calle from '../assets/img/inst-2.jpg';

const db = await getDB();
const [res, esps, retratos] = await Promise.all([resumen(db), especialidades(db), retratosDelDia(db, 8)]);
const conMedicos = esps.filter((e) => e.total > 0);

const ICONO: Record<string, IconName> = {
  tomografia: 'scan', 'video-endoscopia': 'scope', laboratorio: 'microscope', especialidades: 'grid', cirugia: 'scissors',
  uci: 'activity', 'cirugia-bariatrica': 'scale', 'rayos-x': 'bone', 'obstetrica-neonatal': 'baby',
};
const accesos = [
  { icono: 'siren' as const, titulo: 'Emergencias 24 h', texto: clinica.emergencias.texto, href: clinica.emergencias.href, tono: 'sos' },
  { icono: 'calendar' as const, titulo: 'Solicitar cita', texto: 'Por WhatsApp, de lunes a viernes', href: waHref(), externo: true },
  { icono: 'stethoscope' as const, titulo: 'Directorio médico', texto: `${res.medicos} médicos por especialidad`, href: u('/directorio/') },
  { icono: 'video' as const, titulo: 'Telemedicina', texto: 'Incluida en la afiliación', href: u('/afiliacion/') },
];
const cifras = [
  { n: anos(), t: 'años cuidando a Maracaibo' },
  { n: res.medicos, t: 'médicos en el directorio' },
  { n: res.especialidades, t: 'especialidades' },
  { n: 24, t: 'horas de emergencia, todos los días' },
];
const horarios = [
  ['Citas', 'Lunes a viernes, 8:00 a. m. a 4:00 p. m.'],
  ['Emergencias', 'Abiertas las 24 horas'],
  ['Laboratorio', '7:00 a. m. a 5:00 p. m. · emergencias 24 h'],
  ['Tomografía y Rayos X', '7:00 a. m. a 5:00 p. m. · algunos estudios con cita'],
  ['Video endoscopia', 'Lunes a viernes, 8:00 a. m. a 2:00 p. m.'],
];
const mapa = 'https://maps.google.com/maps?q=Policl%C3%ADnica%20Maracaibo%2C%20Av.%208%20Santa%20Rita%2C%20Maracaibo&z=16&output=embed';
---
<Layout titulo={`${clinica.nombre} · Desde ${clinica.desde}`}>
  <!-- 1 · Héroe: la campaña «70 años celebrando tu bienestar», modernizada -->
  <section id="hero" class="hero" data-pin data-scene>
    <div class="hero__bg" aria-hidden="true"><Image src={calle} alt="" widths={[800, 1280]} sizes="100vw" loading="eager" /></div>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__dim" aria-hidden="true"></div>
    <div class="hero__cross" aria-hidden="true" data-parallax="0.5"><Icon name="cross" size={640} /></div>

    <div class="wrap hero__stage">
      <div class="hero__copy">
        <p class="hero__eyebrow"><span class="pill hero__pill">Desde {clinica.desde} · {anos()} años</span></p>
        <h1 class="hero__title">
          <span class="line-mask"><span class="w">Celebrando</span></span>
          <span class="line-mask"><span class="w">tu <em>bienestar</em></span></span>
        </h1>
        <p class="hero__lead">Especialistas, servicios de diagnóstico y emergencias las 24 horas en un solo lugar: {clinica.direccion}, {clinica.ciudad.split(',')[0]}.</p>
        <div class="hero__cta cta-row">
          <a class="btn btn--white" href={waHref()} target="_blank" rel="noopener" data-magnetic><Icon name="calendar" /> Solicitar cita</a>
          <a class="btn btn--ghost" href={u('/directorio/')}><Icon name="search" /> Buscar médico</a>
        </div>
      </div>

      <div class="hero__media">
        <div class="hero__photo"><Image src={fachada} alt="Entrada de la Policlínica Maracaibo con sus bancas de concreto y palmas" widths={[480, 760]} sizes="(max-width: 1100px) 90vw, 38vw" loading="eager" /></div>
        <span class="hero__chip hero__chip--sos"><i></i> Emergencias 24 horas</span>
        <span class="hero__chip hero__chip--docs"><Icon name="stethoscope" size={18} /> {res.medicos} médicos · {res.especialidades} especialidades</span>
        <span class="hero__badge" aria-hidden="true"><b>{anos()}</b> años</span>
      </div>

      <ul class="hero__quick" aria-label="Accesos rápidos">
        {accesos.map((a) => (
          <li data-hero-next>
            <a class:list={['quick', a.tono && `quick--${a.tono}`]} href={a.href} target={a.externo ? '_blank' : undefined} rel={a.externo ? 'noopener' : undefined}>
              <span class="quick__ico"><Icon name={a.icono} /></span>
              <span><b>{a.titulo}</b><small>{a.texto}</small></span>
              <Icon name="arrow" class="quick__arrow" size={18} />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="hero__scroll" aria-hidden="true"><span></span>Desliza</div>
  </section>

  <!-- 2 · Cifras -->
  <section class="cifras" aria-label="La Policlínica en cifras">
    <div class="wrap cifras__grid" data-stagger>
      {cifras.map((c) => <div class="cifra"><strong data-count={c.n}>{c.n}</strong><span>{c.t}</span></div>)}
    </div>
  </section>

  <!-- 3 · Servicios (los 9 del sitio actual, en su orden) -->
  <section class="section" id="servicios" data-scene>
    <div class="wrap">
      <div class="stack head" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">Servicios</span>
        <h2 class="h-xl" data-split="lines">Todo lo que necesitas, en una <span class="underline-accent">misma casa</span></h2>
        <p class="lead" data-reveal="up" data-delay=".2">Diagnóstico por imágenes, laboratorio, cirugía y unidades especializadas, con el respaldo de {anos()} años en Maracaibo.</p>
      </div>
      <div class="svc-grid" data-stagger=".06">
        {indiceServicios.map((s) => (
          <a class="svc" href={u(s.href)} data-tilt data-glow>
            {s.imagen && <Image class="svc__img" src={s.imagen} alt="" widths={[420]} sizes="420px" style={`object-position:${s.pos}`} />}
            <span class="svc__num">{String(s.num).padStart(2, '0')}</span>
            <span class="icon-badge svc__ico"><Icon name={ICONO[s.slug] ?? 'plus'} /></span>
            <h3>{s.nombre}</h3>
            <p>{s.dato}</p>
            <span class="svc__more">Ver más <Icon name="arrow" size={16} class="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 · Especialidades en movimiento -->
  <section class="esp-band" aria-label="Especialidades">
    <div class="wrap esp-band__head">
      <h2 class="h-lg">{res.especialidades} especialidades</h2>
      <a class="btn btn--outline btn--sm" href={u('/especialidades/')}>Ver todas <Icon name="arrow" class="arrow" /></a>
    </div>
    <div class="marquee"><div class="marquee__track">
      {conMedicos.map((e) => <a class="esp-chip" href={u(`/directorio/?esp=${e.slug}`)}><Icon name="plus" size={14} /> {e.nombre}</a>)}
    </div></div>
  </section>

  <!-- 5 · Tu cita en un click (texto del sitio actual) -->
  <section class="section section--mist" id="citas" data-scene>
    <div class="wrap grid-2">
      <div class="stack" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">Citas</span>
        <h2 class="h-xl" data-split="lines">Tu cita en <span class="underline-accent">un click</span></h2>
        <p class="lead" data-reveal="up" data-delay=".15">Si requieres una cita, contáctanos por WhatsApp o a través del {clinica.telefono.texto}. En caso de emergencia, llama al {clinica.emergencias.texto}.</p>
        <div class="cta-row" data-reveal="up" data-delay=".3">
          <a class="btn btn--wa" href={waHref()} target="_blank" rel="noopener"><Icon name="whatsapp" /> Solicitar cita</a>
          <a class="btn btn--outline" href={clinica.telefono.href}><Icon name="phone" /> {clinica.telefono.texto}</a>
        </div>
      </div>
      <div class="card horario" data-reveal="right">
        <div class="horario__head"><span class="icon-badge"><Icon name="clock" /></span><h3>Horarios</h3></div>
        <dl>{horarios.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
        <a class="horario__sos" href={clinica.emergencias.href}><Icon name="siren" /> Emergencias {clinica.emergencias.texto}</a>
      </div>
    </div>
  </section>

  <!-- 6 · Directorio -->
  <section class="section" id="medicos" data-scene>
    <div class="wrap">
      <div class="medicos__head">
        <div class="stack" data-reveal-scope>
          <span class="eyebrow" data-reveal="up">Directorio médico</span>
          <h2 class="h-xl" data-split="lines">Encuentra a <span class="underline-accent">tu médico</span></h2>
        </div>
        <form class="buscador" action={u('/directorio/')} method="get" role="search" data-reveal="up" data-delay=".15">
          <label class="sr-only" for="q">Nombre del médico o especialidad</label>
          <Icon name="search" />
          <input class="buscador__input" id="q" name="q" type="search" placeholder="Nombre o especialidad, p. ej. cardiología" autocomplete="off" />
          <button class="btn btn--primary btn--sm" type="submit">Buscar</button>
        </form>
      </div>
      <div class="medicos__grid" data-stagger=".06">
        {retratos.map((m) => <MedicoCard medico={m} />)}
      </div>
      <div class="medicos__foot" data-reveal="up"><a class="btn btn--primary" href={u('/directorio/')}>Ver los {res.medicos} médicos <Icon name="arrow" class="arrow" /></a></div>
    </div>
  </section>

  <!-- 7 · Afiliación y telemedicina -->
  <section class="section section--navy tele" data-scene>
    <div class="tele__glow" aria-hidden="true"></div>
    <div class="wrap grid-2">
      <div class="stack" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">Afiliación</span>
        <h2 class="h-xl" data-split="lines">Todos los servicios a un único precio, <span class="accent">con telemedicina</span></h2>
        <ul class="tele__list" data-stagger>
          {afiliacion.incluye.map((i) => <li><Icon name="check" /> {i}</li>)}
        </ul>
        <div class="cta-row" data-reveal="up">
          <a class="btn btn--white" href={afiliacion.cta.href} target="_blank" rel="noopener">{afiliacion.cta.texto}</a>
          <a class="btn btn--ghost" href={u('/afiliacion/')}>Conocer la afiliación <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
      <div class="llamada" data-reveal="scale" data-delay=".2" aria-hidden="true">
        <div class="llamada__top"><span class="badge-live"><i></i> Sala de espera</span><Icon name="video" /></div>
        <p class="llamada__turno">Tu turno<b>2</b></p>
        <p class="llamada__txt">Un médico de la Policlínica te atenderá por videollamada en unos minutos.</p>
        <div class="llamada__bar"><i></i></div>
      </div>
    </div>
  </section>

  <!-- 8 · Testimonios (los del sitio actual) -->
  <section class="section section--mist" data-scene>
    <div class="wrap">
      <div class="stack head head--center" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">Doctores y pacientes</span>
        <h2 class="h-xl" data-split="lines">Ellos confían <span class="underline-accent">en nosotros</span></h2>
      </div>
      <div class="grid-3" data-stagger=".1">
        {testimonios.map((t) => (
          <figure class="card testimonio">
            <Icon name="quote" size={34} class="testimonio__q" />
            <blockquote>«{t.texto}»</blockquote>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 9 · Ubicación -->
  <section class="section" id="ubicacion" data-scene>
    <div class="wrap grid-2">
      <div class="stack" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">Contacto</span>
        <h2 class="h-xl" data-split="lines">Te esperamos en <span class="underline-accent">Santa Rita</span></h2>
        <ul class="contacto" data-stagger>
          <li><span class="icon-badge"><Icon name="phone" /></span><span><small>Teléfono</small><a href={clinica.telefono.href}>{clinica.telefono.texto}</a></span></li>
          <li><span class="icon-badge icon-badge--sos"><Icon name="siren" /></span><span><small>Emergencias</small><a href={clinica.emergencias.href}>{clinica.emergencias.texto}</a></span></li>
          <li><span class="icon-badge"><Icon name="pin" /></span><span><small>Dirección</small><a href={clinica.mapa} target="_blank" rel="noopener">{clinica.direccion}, {clinica.ciudad}</a></span></li>
          <li><span class="icon-badge"><Icon name="mail" /></span><span><small>Correo</small><a href={`mailto:${clinica.correo}`}>{clinica.correo}</a></span></li>
          <li><span class="icon-badge"><Icon name="clock" /></span><span><small>Horario</small>{clinica.horario.emergencias}</span></li>
        </ul>
      </div>
      <div class="img-frame mapa" data-reveal="iris">
        <iframe src={mapa} title="Mapa: Policlínica Maracaibo, Av. 8 Santa Rita" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- héroe ---------- */
  .hero { position: relative; min-height: calc(100svh - var(--nav-h) - 38px); display: grid; align-items: center; background: var(--navy); color: #c9d3ea; overflow: hidden; isolation: isolate; }
  .hero__bg { position: absolute; inset: 0; z-index: -3; }
  .hero__bg img { width: 100%; height: 100%; object-fit: cover; opacity: .16; filter: grayscale(.3); }
  .hero__glow { position: absolute; inset: 0; z-index: -2; background: radial-gradient(55% 70% at 80% 30%, rgba(46, 163, 242, .45), transparent 65%), radial-gradient(45% 60% at 0% 100%, rgba(1, 77, 183, .7), transparent 60%), linear-gradient(180deg, rgba(36, 52, 95, .4), var(--navy)); }
  .hero__dim { position: absolute; inset: 0; z-index: -1; background: var(--navy-deep); opacity: 0; }
  .hero__cross { position: absolute; z-index: -1; right: -8rem; bottom: -10rem; color: #fff; opacity: .05; }
  .hero__stage { position: relative; display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-block: clamp(3rem, 7vw, 5rem); }
  .hero__copy { display: grid; gap: 1.5rem; }
  .hero__pill { background: var(--gold); color: var(--navy); }
  .hero__title { font-size: clamp(2.8rem, 7vw, 5.6rem); font-weight: 800; color: #fff; line-height: 1.02; letter-spacing: -.03em; }
  .hero__title em { font-style: normal; color: var(--sky); }
  .hero__lead { font-size: clamp(1.05rem, 1.5vw, 1.25rem); max-width: 48ch; color: #d5ddef; }
  .hero__media { position: relative; }
  .hero__photo { border-radius: 28px; overflow: hidden; aspect-ratio: 4 / 5; box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .6); border: 1px solid rgba(255, 255, 255, .14); }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 47% 50%; }
  .hero__chip { position: absolute; display: inline-flex; align-items: center; gap: .5rem; padding: .7rem 1rem; border-radius: 14px; background: rgba(255, 255, 255, .92); color: var(--ink); font-family: var(--font-head); font-weight: 700; font-size: .85rem; box-shadow: 0 18px 40px -18px rgba(0, 0, 0, .5); backdrop-filter: blur(10px); animation: flota 7s ease-in-out infinite; }
  .hero__chip--sos { left: -2rem; top: 12%; }
  .hero__chip--sos i { width: 10px; height: 10px; border-radius: 50%; background: #e53935; box-shadow: 0 0 0 0 rgba(229, 57, 53, .6); animation: latido 1.8s infinite; }
  .hero__chip--docs { right: -1.5rem; bottom: 14%; color: var(--blue); animation-delay: -3s; }
  .hero__badge { position: absolute; left: 50%; bottom: -1.8rem; translate: -50% 0; width: 96px; height: 96px; border-radius: 50%; background: var(--gold); color: var(--navy); display: grid; place-content: center; text-align: center; font-family: var(--font-head); font-weight: 700; font-size: .8rem; line-height: 1; box-shadow: 0 20px 40px -14px rgba(255, 179, 66, .7); }
  .hero__badge b { display: block; font-size: 2rem; font-weight: 800; }
  @keyframes flota { 50% { transform: translateY(-10px); } }
  .hero__quick { list-style: none; margin: 0; padding: 0; grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .quick { display: flex; align-items: center; gap: .9rem; height: 100%; padding: 1.1rem 1.2rem; border-radius: 18px; background: rgba(255, 255, 255, .07); border: 1px solid rgba(255, 255, 255, .14); color: #fff; backdrop-filter: blur(12px); transition: background .3s, transform .4s var(--ease-out), border-color .3s; }
  .quick:hover { background: rgba(255, 255, 255, .14); border-color: rgba(255, 255, 255, .35); transform: translateY(-3px); }
  .quick b { display: block; font-family: var(--font-head); }
  .quick small { color: #b9c5e2; font-size: .82rem; }
  .quick__ico { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; background: rgba(46, 163, 242, .22); flex: none; }
  .quick--sos .quick__ico { background: rgba(229, 57, 53, .3); }
  .quick :global(.quick__arrow) { margin-left: auto; opacity: .6; flex: none; }
  /* escritorio con escena fijada: los accesos aparecen donde estaba el texto */
  :global(html.pin-ok) .hero__quick { position: absolute; left: 0; top: 50%; translate: 0 -50%; width: 54%; grid-template-columns: repeat(2, 1fr); }
  :global(html.pin-ok) .quick { padding: 1.4rem; }
  :global(html.pin-ok:not(.motion-ready)) .hero__quick > li { opacity: 0; }
  .hero__scroll { position: absolute; left: 50%; bottom: 1.2rem; translate: -50% 0; display: grid; justify-items: center; gap: .4rem; font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; color: #9fb0d6; }
  .hero__scroll span { width: 1px; height: 36px; background: linear-gradient(#fff, transparent); animation: baja 2s ease-in-out infinite; transform-origin: top; }
  @keyframes baja { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }

  /* ---------- cifras ---------- */
  .cifras { background: #fff; border-bottom: 1px solid var(--line); }
  .cifras__grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .cifra { padding: 2.2rem 1.5rem; display: grid; gap: .3rem; border-left: 1px solid var(--line); }
  .cifra:first-child { border-left: 0; }
  .cifra strong { font-family: var(--font-head); font-size: clamp(2.4rem, 4vw, 3.4rem); font-weight: 800; color: var(--blue); line-height: 1; }
  .cifra span { font-size: .92rem; }

  /* ---------- servicios ---------- */
  .head { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); max-width: 760px; }
  .head--center { margin-inline: auto; text-align: center; justify-items: center; }
  .head--center .eyebrow { justify-self: center; }
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .svc { position: relative; isolation: isolate; overflow: hidden; display: grid; gap: .6rem; align-content: start; min-height: 250px; padding: 1.8rem; border-radius: var(--radius); background: #fff; border: 1px solid var(--line); transition: border-color .3s, box-shadow .4s var(--ease-out); }
  .svc::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(36, 52, 95, .55), rgba(24, 35, 63, .92)); opacity: 0; transition: opacity .5s var(--ease-out); }
  .svc::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: 0; transition: opacity .4s; background: radial-gradient(260px circle at var(--gx, 50%) var(--gy, 50%), rgba(46, 163, 242, .12), transparent 70%); }
  .svc :global(.svc__img) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.08); transition: opacity .5s var(--ease-out), transform 1.2s var(--ease-out); }
  .svc:hover, .svc:focus-visible { border-color: transparent; box-shadow: var(--shadow); }
  .svc:hover :global(.svc__img), .svc:focus-visible :global(.svc__img) { opacity: 1; transform: scale(1); }
  .svc:hover::before, .svc:focus-visible::before, .svc:hover::after { opacity: 1; }
  .svc:hover :is(h3, p, .svc__num, .svc__more), .svc:focus-visible :is(h3, p, .svc__num, .svc__more) { color: #fff; }
  .svc:hover .svc__ico, .svc:focus-visible .svc__ico { background: rgba(255, 255, 255, .18); color: #fff; }
  .svc__num { position: absolute; top: 1.4rem; right: 1.6rem; font-family: var(--font-head); font-weight: 800; color: #cdd5ea; transition: color .3s; }
  .svc h3 { font-size: 1.2rem; margin-top: .6rem; transition: color .3s; }
  .svc p { font-size: .95rem; transition: color .3s; }
  .svc__more { margin-top: auto; padding-top: .8rem; display: inline-flex; align-items: center; gap: .4rem; font-family: var(--font-head); font-weight: 700; font-size: .85rem; color: var(--blue); transition: color .3s; }
  .svc:hover .svc__more :global(.arrow) { transform: translateX(4px); }

  /* ---------- especialidades ---------- */
  .esp-band { padding-block: 3rem; border-block: 1px solid var(--line); background: #fff; }
  .esp-band__head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .esp-chip { display: inline-flex; align-items: center; gap: .45rem; padding: .75rem 1.2rem; border-radius: 999px; background: var(--mist); color: var(--navy); font-family: var(--font-head); font-weight: 600; font-size: .92rem; white-space: nowrap; transition: background .3s, color .3s; }
  .esp-chip:hover { background: var(--blue); color: #fff; }

  /* ---------- citas ---------- */
  .horario { display: grid; gap: 1.2rem; }
  .horario__head { display: flex; align-items: center; gap: 1rem; }
  .horario dl { margin: 0; display: grid; }
  .horario dl div { display: grid; grid-template-columns: 12.5rem 1fr; gap: 1rem; padding: .85rem 0; border-top: 1px solid var(--line); }
