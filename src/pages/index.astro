  .sala.is-sel { outline: 2px solid var(--navy); outline-offset: 2px; }
  .corte__calle { position: absolute; right: .75rem; bottom: -1.65rem; z-index: 1; font-size: .78rem; font-weight: 600; color: var(--navy); background: var(--plano); padding: 0 .4rem; }
  .piso[data-piso='pb']::after { content: ''; position: absolute; left: calc(-58px - 2.5rem); right: -2.5rem; bottom: -3px; height: 3px; background: var(--navy); }

  .hoja { grid-area: hoja; background: #fff; color: var(--text); border-radius: var(--radius); border: 1px solid var(--line); padding: 1.4rem 1.4rem 1rem; align-self: start; box-shadow: var(--shadow); }
  .hoja__piso summary { list-style: none; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: .1rem 1rem; cursor: pointer; padding-block: .6rem; border-bottom: 1px solid var(--line); }
