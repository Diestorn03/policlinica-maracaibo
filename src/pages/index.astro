---
// Portada. Una sola apuesta, sacada del mundo real de la clínica: sus médicos y su edificio.
//  · Héroe azul marino (estilo ExpertsDDT): la cruz del logo armada con retratos reales, único momento orquestado al cargar.
//  · El edificio en corte arquitectónico: azotea, ascensor, losas, nivel de calle y los consultorios como ventanas;
//    en escritorio la cabina del «+» recorre los pisos con el scroll. Solo azules y blancos.
//  · Lee la base con getDB() en los dos modos (servidor y demo de GitHub Pages).
export const prerender = false;
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/ui/Icon.astro';
import { getDB, u } from '../lib/entorno';
import { clave, especialidades, medicos, resumen, retratosDelDia, type Medico } from '../lib/db';
import { nb } from '../components/inner/texto';
import { afiliacion, anos, clinica, servicios, testimonios } from '../data/site';
import { iniciales, miniatura, PISOS, telHref, ubicacion, waHref, type Piso } from '../lib/sitio';
import entrada from '../assets/img/inst-3.jpg';
import accesoEmergencia from '../assets/img/inst-5.jpg';

const db = await getDB();
const [res, esps, todos, caras] = await Promise.all([resumen(db), especialidades(db), medicos(db), retratosDelDia(db, 24)]);
const espsConMedicos = esps.filter((e) => e.total > 0);

// La cruz: brazos de 2 de 6 celdas (proporción del «+» del logo); anillo 1 alrededor del sello, anillo 2 en las puntas.
// La misma persona puede estar dos veces en el directorio («Dr. David J. Perozo» y «Dr. David Perozo»): en la cruz sale una vez.
const CELDAS = [[1, 2], [1, 3], [2, 4], [3, 4], [4, 3], [4, 2], [3, 1], [2, 1], [0, 2], [0, 3], [2, 5], [3, 5], [5, 3], [5, 2], [3, 0], [2, 0]];
const persona = (nombre: string) => clave(nombre).replace(/\b[a-z]\.\s*/g, '');
const unicas = [...new Map(caras.map((m) => [persona(m.nombre), m])).values()];
const cruz = unicas.slice(0, CELDAS.length).map((m, i) => ({ m, r: CELDAS[i][0], c: CELDAS[i][1], anillo: i < 8 ? 1 : 2 }));
const especialidadDe = (m: Medico) => m.especialidades.map((e) => e.nombre).join(', ');

// El edificio: médicos agrupados por piso y consultorios (ventanas) de cada piso
type Fila = { m: Medico; puertas: string[]; donde: string };
const porPiso = new Map<Piso, Fila[]>(PISOS.map((p) => [p.id, []]));
for (const m of todos) {
  const ub = ubicacion(m.consultorio);
  if (ub.piso) porPiso.get(ub.piso)!.push({ m, puertas: ub.puertas, donde: ub.puertas.length ? `consultorio ${ub.puertas.join(', ')}` : ub.texto.split(', ').slice(1).join(', ') });
}
const orden = (a: string, b: string) => parseInt(a) - parseInt(b) || a.localeCompare(b);
const edificio = PISOS.map((p) => {
  const filas = porPiso.get(p.id)!;
  const puertas = [...new Set(filas.flatMap((f) => f.puertas))].sort(orden);
  return { ...p, filas, puertas, cuenta: (d: string) => filas.filter((f) => f.puertas.includes(d)).length };
});
const medicosTxt = (n: number) => `${n} ${n === 1 ? 'médico' : 'médicos'}`;

const estudios = ['tomografia', 'rayos-x', 'laboratorio', 'video-endoscopia'].map((s) => servicios.find((x) => x.slug === s)!);
const unidades = [
  { s: 'cirugia', texto: 'Operaciones electivas y de urgencia.' },
  { s: 'uci', texto: 'Medicina crítica, con banco de sangre, laboratorio y radiología las 24 horas.' },
  { s: 'cirugia-bariatrica', texto: 'Un equipo coordinado de especialistas, psicólogos y nutricionistas.' },
  { s: 'obstetrica-neonatal', texto: 'Atención durante el embarazo, el parto y el puerperio.' },
].map((x) => ({ ...x, ...servicios.find((y) => y.slug === x.s)! }));
const notaEstudio: Record<string, string> = {
  tomografia: '7:00 a. m. a 5:00 p. m. Algunos estudios requieren cita previa.',
  'rayos-x': '7:00 a. m. a 5:00 p. m. Algunos estudios requieren cita previa.',
  laboratorio: '7:00 a. m. a 5:00 p. m. Emergencias las 24 horas.',
  'video-endoscopia': 'Lunes a viernes, de 8:00 a. m. a 2:00 p. m.',
};
const mapa = 'https://maps.google.com/maps?q=Policl%C3%ADnica%20Maracaibo%2C%20Av.%208%20Santa%20Rita%2C%20Maracaibo&z=16&output=embed';
---
<Layout titulo={`${clinica.nombre}, atención médica desde ${clinica.desde}`}>
  <!-- Héroe -->
  <section class="hero" id="hero">
    <div class="hero__glow" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="wrap hero__grid">
      <div class="hero__texto">
        <h1 class="h-display">Atención médica en Maracaibo desde {clinica.desde}</h1>
        <p class="lead"><span data-count={res.medicos}>{res.medicos}</span> médicos de <span data-count={res.conMedicos}>{res.conMedicos}</span> especialidades, laboratorio, estudios por imágenes y emergencias las 24 horas, en la {clinica.direccion}.</p>
        <div class="hero__tareas">
          <a class="btn btn--sos btn--tarea" href={clinica.emergencias.href}>Llamar a emergencias <small>{clinica.emergencias.texto}</small></a>
          <a class="btn btn--white btn--tarea" href={waHref()} target="_blank" rel="noopener">Pedir cita por WhatsApp <small>Lunes a viernes, 8:00 a. m. a 4:00 p. m.</small></a>
        </div>
        <a class="hero__buscar" href="#pisos">Buscar un médico</a>
      </div>

      <figure class="cruz">
        <div class="cruz__grid">
          {cruz.map(({ m, r, c, anillo }) => (
            <a class="cruz__t" href={u(`/directorio/?q=${encodeURIComponent(m.nombre.replace(/^Dra?\. /, ''))}`)} data-anillo={anillo} data-r={r} data-c={c}
              style={`grid-area:${r + 1}/${c + 1}`} aria-label={`${m.nombre}, ${especialidadDe(m)}`} data-quien={`${m.nombre}, ${especialidadDe(m).toLowerCase()}`}>
              <img src={u(miniatura(m.foto))} alt="" width="160" height="160" decoding="async" />
            </a>
          ))}
          <div class="cruz__sello" aria-hidden="true"><b>{anos()}</b><span>años</span></div>
        </div>
        <figcaption aria-live="polite">Algunos de nuestros {res.medicos} médicos</figcaption>
      </figure>
    </div>
  </section>

  <!-- El edificio, en corte -->
  <section class="edificio" id="pisos" aria-labelledby="pisos-t">
    <div class="edificio__escena">
      <div class="wrap edificio__grid">
        <div class="edificio__head">
          <h2 class="h-xl" id="pisos-t" data-split="lines">Encuentra el piso y el consultorio de tu médico</h2>
          <p data-reveal="up" data-delay=".15">Elige un piso para ver sus consultorios, o escribe el nombre del médico o la especialidad.</p>
          <form class="buscador" action={u('/directorio/')} method="get" role="search">
            <label class="sr-only" for="q">Nombre del médico o especialidad</label>
            <Icon name="search" />
            <input id="q" name="q" type="search" placeholder="Médico o especialidad" autocomplete="off" />
            <button class="btn btn--sm btn--primary" type="submit">Buscar</button>
          </form>
        </div>

        <div class="corte" data-reveal="up" data-delay=".1">
          <div class="corte__techo" aria-hidden="true"><span class="corte__letrero"><Icon name="cross" size={14} /> Policlínica</span></div>
          <div class="corte__cuerpo">
            <div class="corte__ascensor" aria-hidden="true"><span class="cabina"><Icon name="cross" size={16} /></span></div>
            <ol class="pisos">
              {edificio.map((p) => (
                <li class="piso" data-piso={p.id}>
                  <button class="piso__nombre" type="button" aria-controls={`hoja-${p.id}`}><span>{p.nombre}</span><small>{medicosTxt(p.filas.length)}</small></button>
                  <ul class="salas">
                    {p.puertas.map((d, i) => (
                      <li><button class="sala" type="button" data-puerta={d} style={`--i:${i}`} aria-label={`Consultorio ${d}, ${p.nombre}, ${medicosTxt(p.cuenta(d))}`}>{d}</button></li>
                    ))}
                  </ul>
                  {p.id === 'pb' && <span class="corte__calle" aria-hidden="true">Nivel de calle, {clinica.direccion.split(',')[0]}</span>}
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div class="hoja" data-lenis-prevent data-reveal="up" data-delay=".2">
          {edificio.map((p) => (
            <details class="hoja__piso" id={`hoja-${p.id}`} data-piso={p.id} open>
              <summary><span>{p.nombre}</span><small>{medicosTxt(p.filas.length)} en {p.puertas.length} {p.puertas.length === 1 ? 'consultorio' : 'consultorios'}</small><i class="mas" aria-hidden="true"></i></summary>
              <div class="hoja__filtro" hidden><p></p><button class="link" type="button">Ver todo el piso</button></div>
              <ul class="hoja__lista">
                {p.filas.map(({ m, puertas, donde }) => (
                  <li data-puertas={puertas.join(' ')}>
                    {m.foto ? <img src={u(miniatura(m.foto))} alt="" width="56" height="56" loading="lazy" decoding="async" /> : <span class="ini" aria-hidden="true">{iniciales(m.nombre)}</span>}
                    <div>
                      <b>{m.nombre}</b>
                      <span>{especialidadDe(m)}{donde && `, ${donde}`}</span>
                      {m.telefono && <a href={telHref(m.telefono)}>{m.telefono}</a>}
                    </div>
                  </li>
                ))}
              </ul>
            </details>
          ))}
          <p class="hoja__mas"><a class="link" href={u('/directorio/')}>Ver los {res.medicos} médicos en el directorio</a></p>
          <p class="sr-only" id="pisos-estado" aria-live="polite"></p>
        </div>
      </div>
      <details class="wrap edificio__esps">
        <summary>Ver las {espsConMedicos.length} especialidades con médicos</summary>
        <ul>{espsConMedicos.map((e) => <li><a href={u(`/directorio/?esp=${e.slug}`)}>{e.nombre}</a></li>)}</ul>
      </details>
    </div>
  </section>

  <!-- Servicios -->
  <section class="section servicios" id="servicios">
    <div class="wrap">
      <h2 class="h-xl servicios__t" data-split="lines">Estudios, cirugía y cuidados intensivos en un mismo edificio</h2>
      <h3 class="h-lg" data-reveal="up">Estudios y diagnóstico</h3>
      <ul class="estudios" data-stagger=".07">
        {estudios.map((s) => (
          <li>
            <a href={u(`/servicios/${s.slug}/`)}>
              <span class="estudios__nombre">{s.nombre}</span>
              <span class="estudios__nota">{nb(notaEstudio[s.slug])}</span>
              <span class="estudios__foto"><Image src={s.imagen} alt={s.alt} widths={[240, 360]} sizes="180px" style={`object-position:${s.pos}`} /></span>
            </a>
          </li>
        ))}
      </ul>
      <h3 class="h-lg" data-reveal="up">Cirugía y unidades especializadas</h3>
      <ul class="unidades" data-stagger=".08">
        {unidades.map((s) => (
          <li>
            <a href={u(`/servicios/${s.slug}/`)}>
              <span class="unidades__foto"><Image src={s.imagen} alt={s.alt} widths={[360, 560, 800]} sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 25vw" style={`object-position:${s.pos}`} /></span>
              <span class="unidades__nombre">{s.nombre}</span>
              <span>{s.texto}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="servicios__esp" data-reveal="up"><b>Especialidades</b> {res.conMedicos} especialidades con médicos en el directorio. <a class="link" href={u('/especialidades/')}>Ver las especialidades</a></p>
    </div>
  </section>

  <!-- Afiliación -->
  <section class="section afiliacion">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="wrap afiliacion__grid">
      <div>
        <h2 class="h-xl" data-split="lines">{afiliacion.idea.replace(/\.$/, '')}</h2>
        <p class="afiliacion__precio" data-reveal="up">Consulta el precio por WhatsApp.</p>
        <ul class="afiliacion__incluye" data-stagger=".08">{afiliacion.incluye.map((i) => <li>{i}</li>)}</ul>
        <div class="cta-row">
          <a class="btn btn--white" href={afiliacion.cta.href} target="_blank" rel="noopener">{afiliacion.cta.texto}</a>
          <a class="afiliacion__link" href={u('/afiliacion/')}>Cómo funciona la afiliación</a>
        </div>
      </div>
      <div>
        <h3 class="h-lg" data-reveal="up">Así es una consulta por videollamada</h3>
        <ol class="pasos" data-stagger=".12">
          <li>Entra a tu panel con tu usuario y tu clave.</li>
          <li>Pulsa «Entrar a la videollamada» y espera en la sala de espera.</li>
          <li>Cuando un médico te atienda, se abre la videollamada.</li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Años y testimonios -->
  <section class="section aniversario">
    <div class="wrap aniversario__grid">
      <h2 class="aniversario__t" data-reveal="up"><span><b data-count={anos()}>{anos()}</b> años</span> celebrando tu bienestar</h2>
      <div>
        <ul class="citas">{testimonios.map((t) => <li><blockquote data-lit>«{t.texto}»</blockquote></li>)}</ul>
        <p class="aniversario__pie">Comentarios de pacientes y doctores.</p>
      </div>
    </div>
  </section>

  <!-- Contacto: números, formulario y cómo llegar -->
  <section class="section llegar" id="contacto">
    <div class="wrap llegar__grid">
      <div>
        <h2 class="h-xl" data-split="lines">Estamos en la {clinica.direccion}</h2>
        <dl class="numeros" data-stagger=".1">
          <div><dt>Emergencias</dt><dd><a class="numeros__n numeros__n--sos" href={clinica.emergencias.href}>{clinica.emergencias.texto}</a><span>Todos los días, a toda hora</span></dd></div>
          <div><dt>Citas por WhatsApp</dt><dd><a class="numeros__n" href={waHref()} target="_blank" rel="noopener">{clinica.whatsapp.texto}</a><span>Lunes a viernes, de 8:00 a. m. a 4:00 p. m.</span></dd></div>
          <div><dt>Central</dt><dd><a class="numeros__n" href={clinica.telefono.href}>{clinica.telefono.texto}</a></dd></div>
          <div><dt>Correo</dt><dd><a class="link" href={`mailto:${clinica.correo}`}>{clinica.correo}</a></dd></div>
        </dl>
      </div>

      <!-- Sin servidor que guarde mensajes en la demo: el mensaje se arma aquí y se abre en WhatsApp o en el correo para que la persona lo envíe.
           Sin JS, el formulario cae al cliente de correo (mailto). -->
      <form class="contacto" id="form-contacto" action={`mailto:${clinica.correo}`} method="post" enctype="text/plain" data-wa={clinica.whatsapp.href.match(/phone=(\d+)/)?.[1]} data-correo={clinica.correo} data-reveal="up" data-delay=".15">
        <h3 class="h-lg">Escríbenos</h3>
        <p class="contacto__nota">Tu mensaje se abre en WhatsApp o en tu correo, listo para enviar.</p>
        <div class="contacto__campos">
          <label class="field"><span>Nombre y apellido</span><input class="input" name="nombre" required autocomplete="name" maxlength="80" /></label>
          <label class="field"><span>Teléfono</span><input class="input" name="telefono" type="tel" required autocomplete="tel" inputmode="tel" pattern="[0-9 ()+-]{7,}" maxlength="20" placeholder="0414-1234567" /></label>
          <label class="field"><span>Correo <small>(opcional)</small></span><input class="input" name="correo" type="email" autocomplete="email" maxlength="120" /></label>
          <label class="field"><span>Motivo</span>
            <select class="select" name="motivo">
              <option>Pedir una cita</option>
              <option>Información de un servicio</option>
              <option>Afiliación y telemedicina</option>
              <option>Otro</option>
            </select>
          </label>
          <label class="field contacto__msg"><span>Mensaje</span><textarea class="textarea" name="mensaje" required maxlength="800" rows="4"></textarea></label>
        </div>
        <div class="cta-row">
          <button class="btn btn--wa" type="submit" name="via" value="whatsapp"><Icon name="whatsapp" /> Enviar por WhatsApp</button>
          <button class="btn btn--outline" type="submit" name="via" value="correo"><Icon name="mail" /> Enviar por correo</button>
        </div>
        <p class="contacto__ok" role="status" aria-live="polite"></p>
      </form>
    </div>

    <div class="wrap llegar__lugar">
      <figure class="mapa" data-reveal="clip">
        <iframe src={mapa} title="Mapa: Policlínica Maracaibo, Av. 8 Santa Rita" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <figcaption><a class="link" href={clinica.mapa} target="_blank" rel="noopener">Abrir en Google Maps</a></figcaption>
      </figure>
      <!-- marco cuadrado sobre fotos apaisadas (≈2:1): el recorte pide unas dos veces el ancho del marco, de ahí los sizes -->
      <figure data-reveal="clip" data-delay=".1"><span class="llegar__foto"><Image src={accesoEmergencia} alt="Fachada de la Policlínica con el letrero de Emergencia" widths={[640, 1280]} sizes="(max-width: 1100px) 100vw, 640px" /></span><figcaption>Acceso a Emergencia</figcaption></figure>
      <figure data-reveal="clip" data-delay=".2"><span class="llegar__foto"><Image src={entrada} alt="Entrada de la Policlínica con bancas de concreto y palmas" widths={[640, 1280]} sizes="(max-width: 1100px) 100vw, 640px" /></span><figcaption>La entrada</figcaption></figure>
    </div>
  </section>
</Layout>

<script>
  import { gsap, ScrollTrigger, reduced, getLenis } from '../scripts/motion.js';

  /* ---------- La cruz de los médicos: se arma una vez al cargar ---------- */
  const cruz = document.querySelector('.cruz');
  const nota = cruz?.querySelector('figcaption');
  if (cruz && nota) {
    const tiles = [...cruz.querySelectorAll<HTMLElement>('.cruz__t')];
    const sello = cruz.querySelector('.cruz__sello');
    const ancho = matchMedia('(min-width: 1101px)').matches;
    if (!reduced) {
      // desde el centro de la cruz hacia su celda
      gsap.set(tiles, { xPercent: (_, el) => (2.5 - +el.dataset.c) * 105, yPercent: (_, el) => (2.5 - +el.dataset.r) * 105, scale: ancho ? 0.6 : 1, opacity: 0 });
      gsap.set(sello, { scale: 0, opacity: 0 });
    }
    document.documentElement.classList.add('cruz-lista');
    const k = ancho ? 1 : 0.8;
    const listo = Promise.race([Promise.all(tiles.slice(0, 8).map((t) => t.querySelector('img')!.decode().catch(() => {}))), new Promise((r) => setTimeout(r, 900))]);
    if (!reduced) listo.then(() => gsap.timeline({ onComplete: () => gsap.set([...tiles, sello], { clearProps: 'transform,opacity' }) })
      .to(sello, { scale: 1, opacity: 1, duration: 0.6 * k, ease: 'back.out(1.5)' }, 0)
      .to(tiles.filter((t) => t.dataset.anillo === '1'), { xPercent: 0, yPercent: 0, scale: 1, opacity: 1, duration: 0.9 * k, ease: 'power4.out', stagger: 0.04 }, 0.3 * k)
      .to(tiles.filter((t) => t.dataset.anillo === '2'), { xPercent: 0, yPercent: 0, scale: 1, opacity: 1, duration: 1 * k, ease: 'power4.out', stagger: 0.04 }, 0.5 * k));
    // al pasar o enfocar una cara, el pie dice quién es
    const original = nota.textContent;
    tiles.forEach((t) => {
      const ver = () => (nota.textContent = t.dataset.quien!);
      t.addEventListener('pointerenter', ver);
      t.addEventListener('focus', ver);
      t.addEventListener('pointerleave', () => (nota.textContent = original));
      t.addEventListener('blur', () => (nota.textContent = original));
    });
  }

  /* ---------- Formulario de contacto: arma el mensaje y lo abre en WhatsApp o en el correo ---------- */
  const form = document.querySelector<HTMLFormElement>('#form-contacto');
  if (form) {
    const ok = form.querySelector<HTMLElement>('.contacto__ok')!;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const d = new FormData(form);
      const via = (e as SubmitEvent).submitter?.getAttribute('value') ?? 'whatsapp';
      const v = (k: string) => String(d.get(k) ?? '').trim();
      const texto = [`Hola, soy ${v('nombre')}.`, `Motivo: ${v('motivo')}.`, v('mensaje'), `Teléfono: ${v('telefono')}`, v('correo') && `Correo: ${v('correo')}`].filter(Boolean).join('\n');
      if (via === 'correo') {
        location.href = `mailto:${form.dataset.correo}?` + new URLSearchParams({ subject: `${v('motivo')}, ${v('nombre')}`, body: texto }).toString().replace(/\+/g, '%20');
        ok.textContent = 'Listo: se abrió tu correo con el mensaje. Solo falta pulsar «Enviar».';
      } else {
        open('https://api.whatsapp.com/send/?' + new URLSearchParams({ phone: form.dataset.wa!, text: texto }), '_blank', 'noopener');
        ok.textContent = 'Listo: se abrió WhatsApp con tu mensaje. Solo falta pulsar «Enviar».';
      }
    });
  }

  /* ---------- El edificio: la cabina recorre los pisos con el scroll (escritorio) ---------- */
  const sec = document.querySelector<HTMLElement>('.edificio');
  if (sec) {
    const pisos = [...sec.querySelectorAll<HTMLElement>('.piso')];
    const hojas = [...sec.querySelectorAll<HTMLDetailsElement>('.hoja__piso')];
    const cabina = sec.querySelector<HTMLElement>('.cabina')!;
    const hueco = sec.querySelector<HTMLElement>('.corte__ascensor')!;
    const hoja = sec.querySelector<HTMLElement>('.hoja')!;
    const estado = sec.querySelector<HTMLElement>('#pisos-estado')!;
    // sin más lista abajo, se quita el velo que avisa que sigue (solo existe en escritorio, donde la hoja tiene scroll propio)
    const fin = () => hoja.classList.toggle('is-fin', hoja.scrollTop + hoja.clientHeight >= hoja.scrollHeight - 4);
    hoja.addEventListener('scroll', fin, { passive: true });
    let act = -1;
    const activar = (i: number) => {
      if (i === act) return;
      act = i;
      pisos.forEach((p, j) => p.classList.toggle('is-on', j === i));
      hojas.forEach((h, j) => h.classList.toggle('is-on', j === i));
      fin();
      const p = pisos[i];
      const y = p.getBoundingClientRect().top - hueco.getBoundingClientRect().top + p.offsetHeight / 2 - cabina.offsetHeight / 2;
      gsap.to(cabina, { y, duration: 0.8, ease: 'power3.inOut' });
    };
    const medicosTxt = (n: number) => `${n} ${n === 1 ? 'médico' : 'médicos'}`;
    // Un consultorio elegido deja en la hoja de su piso solo a sus médicos, arriba y sin los demás; null vuelve al piso entero.
    // Las puertas se repiten entre pisos (hay un 16 en el 1.º y en el 2.º): el filtro vale solo para el piso i.
    const elegirPuerta = (i: number, d: string | null) => {
      sec.querySelectorAll<HTMLElement>('.sala').forEach((b) => b.classList.toggle('is-sel', !!d && b.dataset.puerta === d && b.closest('.piso') === pisos[i]));
      hojas.forEach((h, j) => {
        const puerta = j === i ? d : null;
        let n = 0;
        h.querySelectorAll<HTMLElement>('.hoja__lista li').forEach((f) => {
          f.hidden = !!puerta && !(f.dataset.puertas ?? '').split(' ').includes(puerta);
          n += +!f.hidden;
        });
        const filtro = h.querySelector<HTMLElement>('.hoja__filtro')!;
        filtro.hidden = !puerta;
        if (puerta) filtro.querySelector('p')!.textContent = `Consultorio ${puerta} · ${medicosTxt(n)}`;
        if (puerta) estado.textContent = `Consultorio ${puerta}, ${h.querySelector('summary span')!.textContent}: ${medicosTxt(n)}.`;
      });
      if (!d) estado.textContent = '';
      hoja.scrollTop = 0; // en escritorio la hoja tiene su propio scroll: los elegidos quedan a la vista
      fin();
    };
    hojas.forEach((h, i) => h.querySelector('.hoja__filtro button')!.addEventListener('click', () => elegirPuerta(i, null)));

    const mm = gsap.matchMedia();
    mm.add('(min-width: 1101px) and (prefers-reduced-motion: no-preference)', () => {
      sec.classList.add('edificio--vivo');
      ScrollTrigger.refresh();
      const pisoDe = (p: number) => Math.min(pisos.length - 1, Math.floor(p * pisos.length));
      // al ir con un clic a otro piso, el scroll pasa por los de en medio: esos no cambian la hoja ni borran el consultorio elegido
      let destino = -1, espera = 0;
      const st = ScrollTrigger.create({
        trigger: sec, start: 'top top', end: 'bottom bottom',
        onUpdate: (s) => {
          const i = pisoDe(s.progress);
          if (destino >= 0) { if (i === destino) destino = -1; return; }
          if (i !== act) { activar(i); elegirPuerta(i, null); }
        },
      });
      activar(0);
      const irA = (i: number, puerta: string | null = null) => {
        destino = pisoDe(st.progress) === i ? -1 : i;
        clearTimeout(espera);
        espera = window.setTimeout(() => (destino = -1), 1500); // por si el usuario interrumpe el recorrido
        const y = st.start + ((i + 0.5) / pisos.length) * (st.end - st.start);
        const lenis = getLenis();
        lenis ? lenis.scrollTo(y, { duration: 0.9 }) : scrollTo({ top: y, behavior: 'smooth' });
        activar(i);
        elegirPuerta(i, puerta);
      };
      const onClick = (e: Event) => {
        const b = (e.target as HTMLElement).closest('button');
        if (!b) return;
        const i = pisos.indexOf(b.closest('.piso') as HTMLElement);
        if (i >= 0) irA(i, b.dataset.puerta ?? null);
      };
      sec.addEventListener('click', onClick);
      return () => { sec.classList.remove('edificio--vivo'); sec.removeEventListener('click', onClick); st.kill(); clearTimeout(espera); elegirPuerta(-1, null); act = -1; };
    });
    // móvil o movimiento reducido: un piso abierto a la vez; tocar un piso del corte abre su hoja
    mm.add('(max-width: 1100px), (prefers-reduced-motion: reduce)', () => {
      hojas.forEach((h) => (h.open = false));
      const onClick = (e: Event) => {
        const b = (e.target as HTMLElement).closest('button');
        const p = b?.closest('.piso') as HTMLElement | null;
        if (!b || !p) return;
        const i = pisos.indexOf(p);
        const h = hojas[i];
        h.open = true;
        h.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        elegirPuerta(i, b.dataset.puerta ?? null);
      };
      sec.addEventListener('click', onClick);
      return () => sec.removeEventListener('click', onClick);
    });
  }
</script>

<style>
  /* ---------- héroe: azul marino técnico (estilo ExpertsDDT) ---------- */
