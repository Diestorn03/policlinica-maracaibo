---
// Panel del médico: la sala de espera en vivo, sus consultas en curso y su historial.
// El servidor pinta lo que hay; el script sondea cola() de api.js cada 4 s y reconcilia por id (no reconstruye: no se pierde el foco).
// En la demo (GitHub Pages) la página es estática y nace vacía: se llena con la primera respuesta de la simulación.
export const prerender = false;
import Privado from '../../layouts/Privado.astro';
import EnCurso from '../../components/tele/EnCurso.astro';
import FilaCola from '../../components/tele/FilaCola.astro';
import Historial from '../../components/tele/Historial.astro';
import { errorConocido } from '../../components/tele/avisos';
import '../../components/tele/tele.css';
import { DEMO, getDB, u, usuarioDe } from '../../lib/entorno';
import { cola, historial } from '../../lib/tele';

const yo = usuarioDe(Astro.locals, 'medico');
const db = await getDB();
const [viva, pasadas] = await Promise.all([DEMO ? { espera: [], enCurso: [] } : cola(db, yo.id), historial(db, { medicoId: yo.id })]);
const q = Astro.url.searchParams;
const error = errorConocido(q.get('error'));
const atendiendo = q.get('atendiendo') ?? '';
const tomado = viva.enCurso.some((c) => String(c.id) === atendiendo);
const n = viva.espera.length;
const enEspera = (n: number) => (n === 0 ? 'Nadie en espera' : `${n} ${n === 1 ? 'paciente' : 'pacientes'} en espera`);
---
<Privado titulo="Sala de espera" zona="Panel del médico" usuario={yo}>
  {!DEMO && <noscript slot="head"><meta http-equiv="refresh" content="10" /></noscript>}

  <div class="t t--medico" data-cola>
    <header class="medico__cab">
      <div>
        <h1 class="t-titulo">Sala de espera</h1>
        <p class="medico__estado"><b data-contador>{DEMO ? 'Cargando…' : enEspera(n)}</b> <span class="js-solo">Actualizado a las <time data-actualizado>--</time></span></p>
      </div>
      <div class="medico__avisos js-solo">
        <button type="button" class="btn btn--primary btn--sm" aria-describedby="avisos-estado" data-avisos>Activar avisos</button>
        <p id="avisos-estado" role="status" data-avisos-estado>Actívalos para que este equipo suene y deje una notificación cuando llegue un paciente.</p>
      </div>
    </header>

    <div class="t-aviso medico__llegada" data-llegada hidden>
      <p><span class="medico__punto" aria-hidden="true"></span><span data-llegada-txt></span></p>
      <div class="medico__llegada-acciones">
        <button type="button" class="btn btn--primary btn--sm" data-llegada-ver>Ver en la cola</button>
        <button type="button" class="btn btn--outline btn--sm" data-llegada-ok>Entendido</button>
      </div>
    </div>

    <p class="sr-only" role="status" aria-live="polite" data-anuncio></p>
    <p class="t-aviso" role="status" data-sin-conexion hidden>Sin conexión. Seguimos intentando…</p>
    <p class="t-aviso" role="alert" tabindex="-1" data-error hidden={!error}>{error}</p>

    <!-- Consultas en curso -->
    <section class="t-azul" aria-labelledby="t-curso" data-curso-sec hidden={viva.enCurso.length === 0}>
      <div class="grid-bg" aria-hidden="true"></div>
      <h2 id="t-curso">En curso</h2>
      <p class="t-aviso" role="status" data-tomado hidden={!tomado}>Ya es tu paciente. La videollamada se abre aquí automáticamente.</p>
      <ul class="medico__curso" data-curso>
        {viva.enCurso.map((c) => <EnCurso c={c} actual={String(c.id) === atendiendo} />)}
      </ul>
    </section>

    <!-- Cola -->
    <section class="t-hoja" aria-labelledby="t-cola">
      <h2 id="t-cola">Pacientes en espera</h2>
      <form id="cola" method="post" action={u('/api/cola')} class="medico__form">
        <input type="hidden" name="accion" value="atender" />
        <table class="t-tabla t-tabla--cola" data-tabla hidden={n === 0}>
          <caption class="sr-only">Pacientes en espera, por orden de llegada</caption>
          <thead><tr><th scope="col">Turno</th><th scope="col">Paciente</th><th scope="col">Edad</th><th scope="col">Esperando</th><th scope="col">Motivo</th><th scope="col"><span class="sr-only">Acción</span></th></tr></thead>
          <tbody data-filas>
            {viva.espera.map((c, i) => <FilaCola c={c} orden={i + 1} />)}
          </tbody>
        </table>
        <p class="t-vacio" data-vacio hidden={n > 0 || DEMO}>Cuando llegue alguien, aparecerá aquí. Esta página se actualiza sola.</p>
      </form>
    </section>

    <Historial items={pasadas} rol="medico" />

    <template id="pl-fila"><FilaCola /></template>
    <template id="pl-curso"><EnCurso /></template>
  </div>

  <script>
    import { cola } from '../../scripts/api.js';
    import { sondear, errorDeUrl } from '../../components/tele/tele.js';
    import { alarmaDeLlegadas, type Llegada } from '../../components/tele/alarma.ts';
    import { esperando } from '../../lib/sitio.ts';
    import { aFecha } from '../../lib/tele.ts';

    const raiz = document.querySelector<HTMLElement>('[data-cola]');
    if (raiz) {
      const $ = <T extends HTMLElement = HTMLElement>(s: string, r: ParentNode = raiz) => r.querySelector<T>(s)!;
      const base = document.title;
      const cuerpo = $('[data-filas]'), lista = $('[data-curso]');
      const plFila = $<HTMLTemplateElement>('#pl-fila'), plCurso = $<HTMLTemplateElement>('#pl-curso');
      const filas = new Map<string, HTMLElement>(), cards = new Map<string, HTMLElement>();
      const atendiendo = new URLSearchParams(location.search).get('atendiendo') ?? '';
      let primera = true, enfocado = false;
      cuerpo.querySelectorAll<HTMLElement>('tr[data-id]').forEach((tr) => filas.set(tr.dataset.id!, tr));
      lista.querySelectorAll<HTMLElement>('li[data-id]').forEach((li) => cards.set(li.dataset.id!, li));
      const poner = (el: ParentNode, campo: string, v: string) => { const n = el.querySelector(`[data-campo="${campo}"]`); if (n) n.textContent = v; };

      errorDeUrl($('[data-error]'));

      // Alarma de 2 s, notificación que se queda y pantalla encendida cuando llega alguien (ver alarma.ts)
      const alarma = alarmaDeLlegadas(raiz);

      // El reloj de cada fila (cada segundo) y su aviso de espera larga
      const reloj = () => {
        const ahora = new Date();
        for (const tr of Array.from(cuerpo.children) as HTMLElement[]) {
          const seg = (ahora.getTime() - aFecha(tr.dataset.creada!).getTime()) / 1000;
          poner(tr, 'reloj', esperando(tr.dataset.creada!, ahora));
          poner(tr, 'largo', seg >= 1200 ? 'Más de 20 min' : seg >= 600 ? 'Más de 10 min' : '');
        }
      };
      setInterval(reloj, 1000);

      const crear = (pl: HTMLTemplateElement, c: any) => {
        const el = pl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        el.dataset.id = c.id;
        poner(el, 'paciente', c.paciente);
        return el;
      };
      // Pone `el` en la posición `i` de `padre` sin mover los demás (conserva foco y selección)
      const colocar = (padre: HTMLElement, el: HTMLElement, i: number) => { if (padre.children[i] !== el) padre.insertBefore(el, padre.children[i] ?? null); };

      function reconciliar(datos: { espera: any[]; enCurso: any[] }) {
        // --- cola
        const llegaron: Llegada[] = [];
        const ids = new Set(datos.espera.map((c) => String(c.id)));
        for (const [id, tr] of filas) if (!ids.has(id)) { tr.remove(); filas.delete(id); }
        datos.espera.forEach((c, i) => {
          let tr = filas.get(String(c.id));
          if (!tr) {
            tr = crear(plFila, c);
            tr.dataset.creada = c.creada;   // solo al verla por primera vez: así el reloj no se reinicia en cada sondeo
            poner(tr, 'edad', c.edad == null ? 'Sin registrar' : `${c.edad} años`);
            poner(tr, 'motivo', c.motivo || 'Sin motivo indicado');
            const b = $<HTMLButtonElement>('button', tr);
            b.value = c.id; b.setAttribute('aria-label', `Atender a ${c.paciente}`);
            if (!primera) llegaron.push({ id: String(c.id), nombre: c.paciente });
            filas.set(String(c.id), tr);
          }
          colocar(cuerpo, tr, i);
          poner(tr, 'orden', String(i + 1));
          poner(tr, 'siguiente', i === 0 ? 'Siguiente' : '');
        });
        reloj();
        alarma.quedan(ids);
        const n = datos.espera.length;
        $('[data-tabla]').hidden = n === 0;
        $('[data-vacio]').hidden = n > 0;
        $('[data-contador]').textContent = n === 0 ? 'Nadie en espera' : `${n} ${n === 1 ? 'paciente' : 'pacientes'} en espera`;

        // --- en curso
        const idsCurso = new Set(datos.enCurso.map((c) => String(c.id)));
        for (const [id, li] of cards) if (!idsCurso.has(id)) { li.remove(); cards.delete(id); }
        datos.enCurso.forEach((c, i) => {
          let li = cards.get(String(c.id));
          if (!li) {
            li = crear(plCurso, c);
            poner(li, 'edad', c.edad == null ? 'Edad sin registrar' : `${c.edad} años`);
            poner(li, 'motivo', c.motivo || 'sin motivo indicado');
            $('[name="consulta"]', li).setAttribute('value', c.id);
            $('[data-enviar-diagnostico]', li).setAttribute('aria-label', `Guardar diagnóstico y finalizar consulta con ${c.paciente}`);
            const video = li.querySelector<HTMLElement>('[data-video]');
            const sala = String(c.sala ?? '');
            if (video && video.dataset.sala !== sala) video.dataset.sala = sala;
            cards.set(String(c.id), li);
          }
          colocar(lista, li, i);
        });
        $('[data-curso-sec]').hidden = datos.enCurso.length === 0;

        // --- ?atendiendo=<id>: resalta esa consulta, avisa y lleva el foco a «Abrir videollamada» (una sola vez)
        const actual = cards.get(atendiendo);
        cards.forEach((li) => (li === actual ? li.setAttribute('aria-current', 'true') : li.removeAttribute('aria-current')));
        $('[data-tomado]').hidden = !actual;
        if (actual && !enfocado) { enfocado = true; $<HTMLElement>('[data-video]', actual).focus(); }

        // --- llegadas nuevas: aviso para lectores de pantalla, título de la pestaña y alarma
        if (llegaron.length) { $('[data-anuncio]').textContent = `Llegó un paciente: ${llegaron.map((p) => p.nombre).join(', ')}`; alarma.llegaron(llegaron); }
        document.title = n ? `(${n}) Sala de espera` : base;
        $('[data-actualizado]').textContent = new Intl.DateTimeFormat('es-VE', { timeZone: 'America/Caracas', hour: 'numeric', minute: '2-digit', second: '2-digit' }).format(new Date());
        primera = false;
      }

      sondear(
        async () => { const d = await cola(); if (d) reconciliar(d); },
        (ok) => { $('[data-sin-conexion]').hidden = ok; },
      );
    }
  </script>
</Privado>

<style>
  .medico__cab { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; }
  .medico__cab .t-titulo { font-size: clamp(1.8rem, 1.2rem + 2vw, 2.6rem); }
  .medico__estado { display: flex; flex-wrap: wrap; gap: .1rem 1.25rem; margin-top: .5rem; }
  .medico__estado b { font: 600 1.15rem var(--font-head); color: var(--navy); }
  .medico__estado span { color: var(--navy); font-variant-numeric: tabular-nums; }
  .medico__curso { list-style: none; margin: 0; padding: 0; }
  .medico__form { display: grid; gap: 1.25rem; }
  .medico__avisos { display: grid; gap: .35rem; justify-items: end; max-width: 25rem; margin-left: auto; }   /* margin: si baja a su propia línea (tablet), sigue a la derecha */
  .medico__avisos p { font-size: .875rem; color: var(--muted); text-align: right; }
  /* el aviso de llegada: queda a la vista hasta que el médico lo toca (alarma.ts). Doble clase para ganarle a .t-aviso de tele.css llegue en el orden que llegue */
  .t-aviso.medico__llegada { grid-template-columns: minmax(0, 1fr) auto; align-items: center; border-color: var(--blue); background: #eef4ff; }
  .medico__llegada p { display: flex; align-items: flex-start; gap: .7rem; }
  .medico__llegada-acciones { display: flex; flex-wrap: wrap; gap: .5rem; }
  .medico__punto { flex: none; width: 10px; height: 10px; margin-top: .5em; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 0 rgba(1, 77, 183, .6); animation: latido-azul 1.6s infinite; }
  @keyframes latido-azul { 70% { box-shadow: 0 0 0 9px rgba(1, 77, 183, 0); } 100% { box-shadow: 0 0 0 0 rgba(1, 77, 183, 0); } }

  @media (max-width: 640px) {
    .medico__cab .btn { width: 100%; }
    .medico__avisos { justify-items: stretch; max-width: none; width: 100%; }
    .medico__avisos p { text-align: left; }
    .t-aviso.medico__llegada { grid-template-columns: minmax(0, 1fr); }
  }
</style>
