---
// /directorio/ · todos los médicos, con búsqueda por nombre o especialidad y filtro por piso. Dos modos (docs/BACKEND.md):
//  · servidor: el HTML llega ya filtrado con ?q= ?esp= ?piso= (medicos() de lib/db.ts); el formulario GET funciona sin JS.
//  · demo (GitHub Pages): página estática con todos los médicos; filtro.ts lee location.search y filtra en el navegador.
// En los dos se renderizan TODAS las fichas y las que no coinciden salen con `hidden`: así el filtro instantáneo
// puede ampliar la búsqueda sin volver al servidor.
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import MedicoCard from '../../components/ui/MedicoCard.astro';
import { DEMO, getDB, u } from '../../lib/entorno';
import { especialidades, medicos } from '../../lib/db';
import { PISOS, ubicacion, waHref } from '../../lib/sitio';
import { ficha } from '../../components/directorio/buscar';

const db = await getDB();
const params = Astro.url.searchParams; // en la demo viene vacío (página prerenderizada): filtro.ts lee la URL en el navegador
const q = (params.get('q') ?? '').trim().slice(0, 80);
const [esps, todos] = await Promise.all([especialidades(db), medicos(db)]);
const esp = esps.find((e) => e.slug === params.get('esp'))?.slug ?? ''; // un slug desconocido se ignora
const piso = PISOS.find((p) => p.id === params.get('piso'))?.id ?? '';
const hallados = q || esp ? new Set((await medicos(db, { q, esp })).map((m) => m.id)) : null;

const pisoDe = (consultorio: string) => ubicacion(consultorio).piso ?? '';
let orden = 0;
const fichas = todos.map((m) => {
  const p = pisoDe(m.consultorio);
  const ok = (!hallados || hallados.has(m.id)) && (!piso || p === piso);
  return { m, piso: p, ok, orden: ok ? orden++ : -1 };
});
const filtrado = !!(q || esp || piso);
const cuenta = filtrado ? `${orden} ${orden === 1 ? 'resultado' : 'resultados'} de ${todos.length} médicos` : `${todos.length} médicos`;
// de abajo hacia arriba, como se sube el edificio
const pisos = (['pb', '1', '2', '3', 's'] as const).map((id) => ({ ...PISOS.find((p) => p.id === id)!, total: todos.filter((m) => pisoDe(m.consultorio) === id).length }));
---
<Layout titulo="Directorio médico" descripcion="Directorio de los médicos de la Policlínica Maracaibo: busca por nombre, especialidad o piso y llama directo a su consultorio.">
  <PageHero titulo="Encuentra a tu médico" lead="Busca por nombre, especialidad o piso. Cada ficha trae el consultorio y el teléfono." migas={[{ texto: 'Directorio médico' }]} />

  <section class="filtros" aria-label="Buscar en el directorio">
    <form class="wrap filtros__form" id="buscar" action={u('/directorio/')} method="get" role="search">
      <label class="campo">
        <span>Nombre o especialidad</span>
        <input class="input" type="search" name="q" value={q} maxlength="80" autocomplete="off" placeholder="Por ejemplo: pediatría o Atencio" />
      </label>
      <label class="campo">
        <span>Especialidad</span>
        <select class="select" name="esp">
          <option value="">Todas</option>
          {esps.map((e) => <option value={e.slug} selected={e.slug === esp}>{e.nombre} ({e.total})</option>)}
        </select>
      </label>
      <label class="campo">
        <span>Piso</span>
        <select class="select" name="piso">
          <option value="">Todos</option>
          {pisos.map((p) => <option value={p.id} selected={p.id === piso}>{p.nombre} ({p.total})</option>)}
        </select>
      </label>
      <button class="btn btn--primary" type="submit">Buscar</button>
    </form>
  </section>

  <section class="section resultados" aria-labelledby="res-t">
    <div class="wrap">
      <h2 class="sr-only" id="res-t">Médicos del directorio</h2>
      {DEMO && <noscript><p class="note">Esta demostración filtra con JavaScript. Sin él se muestran todos los médicos.</p></noscript>}
      <p class="cuenta"><span id="cuenta" aria-live="polite">{cuenta}</span> <a class="link" id="quitar" data-limpiar href={u('/directorio/')} hidden={!filtrado}>Quitar los filtros</a></p>

      <!-- cascada de entrada al cargar (motor); con filtro puesto no: el motor contaría también las fichas ocultas y las pocas que coinciden tardarían en salir -->
      <ul class="lista" id="lista">
        {fichas.map(({ m, piso: p, ok, orden: i }) => (
          <li data-ficha={ficha(m.nombre, ...m.especialidades.map((e) => e.nombre))} data-esp={m.especialidades.map((e) => e.slug).join(' ')} data-piso={p} hidden={!ok}>
            <MedicoCard medico={m} lazy={i < 0 || i >= 4} />
          </li>
        ))}
      </ul>

      <div class="vacio" id="vacio" hidden={orden > 0}>
        <h3 class="h-lg">No encontramos médicos con esa búsqueda</h3>
        <ul>
          <li>Escribe solo el apellido o una parte del nombre.</li>
          <li>Quita el filtro de especialidad o el de piso.</li>
          <li>Elige la especialidad de la lista en vez de escribirla.</li>
        </ul>
        <div class="cta-row">
          <a class="btn btn--primary" data-limpiar href={u('/directorio/')}>Ver todos los médicos</a>
          <a class="btn btn--outline" href={waHref('Busco a un médico de la Policlínica')} target="_blank" rel="noopener">Preguntar por WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '../../components/directorio/filtro.ts';
</script>

<style>
  .filtros { background: #fff; border-bottom: 1px solid var(--line); padding-block: 1.2rem; }
  .filtros__form { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, .8fr) auto; gap: .8rem 1rem; align-items: end; }
  .campo { display: grid; gap: .35rem; }
  .campo span { font-size: .9375rem; font-weight: 600; color: var(--navy); }
  .campo :is(.input, .select) { height: 52px; }
  .resultados { background: var(--mist); padding-block: clamp(1.75rem, 4vw, 3rem) clamp(3rem, 7vw, 5.5rem); }
  .cuenta { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem 1.2rem; margin-bottom: 1.4rem; font-weight: 600; color: var(--navy); }
  .cuenta .link { display: inline-flex; align-items: center; min-height: 44px; }

  .lista { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(212px, 1fr)); gap: 1.25rem; }
  .lista > li { display: grid; content-visibility: auto; contain-intrinsic-size: auto 22rem; }
  .lista > li[hidden], .vacio[hidden], .cuenta .link[hidden] { display: none; }
  /* tamaño de toque de los enlaces de la ficha compartida */
  .lista :global(.medico__esps a), .lista :global(.medico__tel) { min-height: 44px; display: inline-flex; align-items: center; }
  .lista :global(.medico__esps) { gap: 0 .35rem; }
  /* sin efecto al pasar el ratón sobre cada ficha, y rótulos de especialidad como las losas del resto del sitio (la píldora es solo para botones) */
  .lista :global(.medico) { transition: none; }
  .lista :global(.medico:hover) { box-shadow: none; border-color: var(--line); }
  .lista :global(.medico__foto img) { transition: none; }
  #lista :global(.medico:hover .medico__foto img) { transform: none; } /* con id: la regla de la ficha lleva más clases */
  .lista :global(.medico__esps .pill) { border-radius: 2px; }

  .vacio { display: grid; gap: 1.2rem; justify-items: start; max-width: 40rem; padding-block: 1rem; }
  .vacio ul { margin: 0; padding-left: 1.2rem; display: grid; gap: .3rem; }

  @media (max-width: 960px) {
    .filtros__form { grid-template-columns: 1fr 1fr; }
    .filtros__form .campo:first-child { grid-column: 1 / -1; }
    .filtros__form .btn { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .filtros__form { grid-template-columns: 1fr; }
    .lista { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; }
  }
</style>
