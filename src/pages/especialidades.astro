---
// Especialidades de la A a la Z, agrupadas por letra como un índice: cada una es una tarjeta con su cuenta de médicos que lleva
// a su lista en el directorio. Las que aún no tienen médicos van al final, aparte, sin enlace.
//  · Buscador que filtra al escribir (sin acentos) y casilla «solo las que tienen médicos»: todo en el navegador, así funciona en la demo estática.
//  · prerender = false como la portada: en servidor las cuentas son en vivo; en la demo se fijan al compilar.
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import { getDB, u } from '../lib/entorno';
import { clave, especialidades, resumen } from '../lib/db';
import { waHref } from '../lib/sitio';

const db = await getDB();
const [esps, res] = await Promise.all([especialidades(db), resumen(db)]);

// especialidades() ya llega en orden alfabético sin acentos (ORDER BY clave)
const con = esps.filter((e) => e.total > 0);
const sin = esps.filter((e) => e.total === 0);
const medicosTxt = (n: number) => `${n} ${n === 1 ? 'médico' : 'médicos'}`;
const letras = Map.groupBy(con, (e) => clave(e.nombre).charAt(0).toUpperCase());
---
<Layout titulo="Especialidades" descripcion={`${res.especialidades} especialidades médicas de la Policlínica Maracaibo, de la A a la Z, con sus médicos en el directorio.`}>
  <PageHero titulo="Especialidades" lead={`${res.especialidades} especialidades, ${res.conMedicos} de ellas con médicos en el directorio. Elige una para ver sus médicos.`} migas={[{ texto: 'Especialidades' }]} />

  <!-- Herramientas (solo con JavaScript: filtran lo que el HTML ya trae) -->
  <section class="herramientas" aria-label="Buscar una especialidad">
    <div class="wrap herramientas__in">
      <label class="busca" for="buscar-esp">
        <Icon name="search" />
        <span class="sr-only">Buscar una especialidad</span>
        <input id="buscar-esp" type="search" placeholder="Por ejemplo: cardiología" maxlength="80" autocomplete="off" />
      </label>
      <label class="solo"><input type="checkbox" id="solo-con" /> Mostrar solo las que tienen médicos</label>
      <p class="cuenta" id="cuenta-esp" aria-live="polite">{esps.length} especialidades</p>
    </div>
  </section>

  <section class="section lista">
    <div class="wrap">
      <h2 class="lista__t">Con médicos en el directorio <small>{con.length}</small></h2>
      <p class="lista__ayuda">Elige una especialidad para ver a sus médicos, su consultorio y su teléfono.</p>
      <div id="lista-esp">
        {[...letras].map(([letra, items]) => (
          <div class="letra">
            <h3 class="letra__t">{letra}</h3>
            <ul class="esp" data-stagger=".04">
              {items.map((e) => (
                <li data-n={clave(e.nombre)}>
                  <a href={u(`/directorio/?esp=${e.slug}`)}>
                    <span class="esp__nombre">{e.nombre}</span>
                    <span class="esp__n"><Icon name="users" size={16} />{medicosTxt(e.total)}</span>
                    <span class="esp__ir" aria-hidden="true"><Icon name="arrow" size={16} /></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      {sin.length > 0 && (
        <div class="sin" id="sin-medicos">
          <h2 class="lista__t" data-reveal="up">Sin médicos en el directorio por ahora <small>{sin.length}</small></h2>
          <p class="lista__ayuda">Todavía no hay médicos de estas especialidades en el directorio. Para preguntar por una, <a class="link" href={waHref('Información sobre una especialidad')} target="_blank" rel="noopener">escríbenos por WhatsApp</a>.</p>
          <ul class="esp esp--sin" data-stagger=".03">
            {sin.map((e) => <li data-n={clave(e.nombre)}><span>{e.nombre}</span></li>)}
          </ul>
        </div>
      )}

      <div class="vacio" id="vacio-esp" role="status" hidden>
        <p id="vacio-nada">No encontramos «<b id="vacio-q"></b>». Prueba con otra palabra o busca en el <a class="link" id="vacio-dir" href={u('/directorio/')}>directorio médico</a>.</p>
        <p id="vacio-sin" hidden>Hay coincidencias entre las especialidades que aún no tienen médicos: desmarca «Mostrar solo las que tienen médicos» para verlas.</p>
      </div>

      <p class="mas">¿Buscas a un médico por su nombre? <a class="link" href={u('/directorio/')}>Ir al directorio</a></p>
    </div>
  </section>
</Layout>

<script>
  import { ScrollTrigger } from '../scripts/motion.js';
  import { termino } from '../components/directorio/buscar';

  const q = document.querySelector<HTMLInputElement>('#buscar-esp');
  const solo = document.querySelector<HTMLInputElement>('#solo-con');
  const sinBloque = document.querySelector<HTMLElement>('#sin-medicos');
  let filas = [...document.querySelectorAll<HTMLElement>('.lista .esp > li')];
  let grupos = [...document.querySelectorAll<HTMLElement>('.letra')];
  const cuenta = document.getElementById('cuenta-esp');
  const vacio = document.getElementById('vacio-esp');
  const vacioQ = document.getElementById('vacio-q');
  const vacioDir = document.querySelector<HTMLAnchorElement>('#vacio-dir');

  if (q && solo && cuenta && vacio && vacioQ && vacioDir) {
    const dirBase = vacioDir.getAttribute('href')!; // ya trae la base de la demo (u())
    const aplicar = () => {
      const t = termino(q.value.slice(0, 80));
      let n = 0, enSin = 0, ocultas = 0;
      for (const li of filas) {
        const sinMedicos = !!sinBloque?.contains(li);
        const coincide = !t || li.dataset.n!.includes(t);
        const ok = coincide && !(sinMedicos && solo.checked);
        ocultas += +(coincide && !ok);
        li.hidden = !ok;
        n += +ok;
        enSin += +(ok && sinMedicos);
      }
      if (sinBloque) sinBloque.hidden = enSin === 0; // sin filas, tampoco su título
      grupos.forEach((g) => (g.hidden = !g.querySelector('li:not([hidden])'))); // ni la letra
      cuenta.textContent = n === filas.length ? `${n} especialidades` : `${n} de ${filas.length} especialidades`;
      const buscado = q.value.trim();
      vacio.hidden = n > 0;
      document.getElementById('vacio-nada')!.hidden = ocultas > 0;
      document.getElementById('vacio-sin')!.hidden = ocultas === 0;
      vacioQ.textContent = buscado;
      vacioDir.href = buscado ? `${dirBase}?q=${encodeURIComponent(buscado)}` : dirBase;
      // la página cambia de alto: el motor recalcula dónde se activa cada aparición pendiente
      ScrollTrigger.refresh();
    };
    let espera = 0;
    q.addEventListener('input', () => { clearTimeout(espera); espera = window.setTimeout(aplicar, 120); });
    solo.addEventListener('change', aplicar);
    q.form?.addEventListener('submit', (e) => e.preventDefault());
    // versión PHP: vivo.ts cambió la lista por la de la base real
    document.addEventListener('pm:datos', () => {
      filas = [...document.querySelectorAll<HTMLElement>('.lista .esp > li')];
      grupos = [...document.querySelectorAll<HTMLElement>('.letra')];
      aplicar();
    });
  }
</script>

<style>
  /* sin JavaScript no hay buscador (la lista completa se lee igual) */
  :global(html:not(.js)) .herramientas { display: none; }
  .herramientas { position: sticky; top: var(--nav-h); z-index: 20; background: rgba(255, 255, 255, .94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); padding-block: .8rem; }
  .herramientas__in { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1.8rem; }
  .busca { flex: 1 1 20rem; max-width: 32rem; display: flex; align-items: center; gap: .6rem; padding: .2rem 1rem; border-radius: 999px; background: #fff; color: var(--muted); border: 1.5px solid var(--line); }
  .busca:focus-within { border-color: var(--blue); box-shadow: 0 0 0 4px rgba(1, 77, 183, .12); }
  .busca input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; min-height: 46px; color: var(--ink); }
  .solo { display: inline-flex; align-items: center; gap: .6rem; min-height: 44px; font-weight: 600; color: var(--navy); cursor: pointer; }
  .solo input { width: 1.3rem; height: 1.3rem; accent-color: var(--blue); }
  .cuenta { margin-left: auto; font-size: .9375rem; color: var(--text); }

  .lista { padding-top: clamp(2rem, 4vw, 3.5rem); background: var(--mist); }
  .lista__t { font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem); }
  /* la cuenta va pegada al final del título aunque este ocupe dos líneas */
  .lista__t small { display: inline-block; vertical-align: .3em; margin-left: .5rem; font: 600 .9375rem var(--font-body); color: var(--blue); background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: .1rem .7rem; letter-spacing: 0; }
  .lista__ayuda { margin-top: .4rem; max-width: 60ch; }
  /* índice A–Z como el de un diccionario: tres columnas que se leen de arriba abajo, cada letra con sus tarjetas debajo
     (en el teléfono, una sola columna). Las tarjetas no se parten entre columnas; la letra no se queda sola al pie */
  #lista-esp { margin-top: 1.4rem; columns: 3 17rem; column-gap: 1.5rem; }
  .letra { break-inside: avoid; } /* cada letra entera en su columna: sin tarjetas huérfanas arriba de la siguiente */
  .letra + .letra { margin-top: 1rem; }
  .letra__t { display: flex; align-items: center; gap: .8rem; margin-bottom: .7rem; font-size: 1.6rem; line-height: 1.1; letter-spacing: -.03em; color: var(--blue); break-after: avoid; }
  .letra__t::after { content: ''; flex: 1; height: 1px; background: #d5dcef; }
  .esp { list-style: none; margin: 0; padding: 0; }
  .esp li { break-inside: avoid; padding-bottom: .6rem; }
  .esp li[hidden], .sin[hidden], .vacio[hidden], .letra[hidden] { display: none; }
  .esp a { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .25rem .8rem; min-height: 4.25rem; padding: .75rem .9rem .75rem 1.1rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 1px 2px rgba(24, 35, 63, .06); transition: border-color .2s, box-shadow .3s var(--ease-out), transform .3s var(--ease-out); }
  .esp a:hover, .esp a:focus-visible { border-color: var(--blue); box-shadow: var(--shadow); transform: translateY(-2px); }
  .esp__nombre { grid-column: 1; font: 600 1.0625rem/1.3 var(--font-head); letter-spacing: -.015em; color: var(--navy); }
  .esp a:hover .esp__nombre { color: var(--blue); }
  .esp__n { grid-column: 1; display: inline-flex; align-items: center; gap: .4rem; font-size: .9rem; color: var(--text); }
  .esp__n :global(svg) { color: var(--slate); }
  .esp__ir { grid-column: 2; grid-row: 1 / 3; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; background: var(--mist); color: var(--blue); transition: background-color .2s, color .2s; }
  .esp a:hover .esp__ir, .esp a:focus-visible .esp__ir { background: var(--blue); color: #fff; }

  /* sin médicos: solo nombres, en etiquetas discretas (no son enlaces) */
  .sin { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #d5dcef; }
  .esp--sin { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
  .esp--sin li { padding-bottom: 0; }
  .esp--sin li > span { display: inline-flex; align-items: center; min-height: 40px; padding: .3rem 1rem; border-radius: 999px; border: 1px dashed #b9c4de; color: var(--text); background: rgba(255, 255, 255, .6); }

  .vacio { padding-block: 2rem; }
  .vacio p { font-size: 1.125rem; max-width: 48ch; }
  .vacio b { color: var(--navy); font-weight: 600; overflow-wrap: anywhere; }
  .mas { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: 1.0625rem; }
  .mas .link { white-space: nowrap; }

  /* en el teléfono la barra ocuparía un cuarto de la pantalla: no se queda fija */
  @media (max-width: 899px) { .herramientas { position: static; backdrop-filter: none; -webkit-backdrop-filter: none; } }
  @media (max-width: 640px) {
    .cuenta { margin-left: 0; flex-basis: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .esp a { transition: none; } .esp a:hover, .esp a:focus-visible { transform: none; } }
</style>
