---
// Servicios: los ocho de la clínica en dos grupos, como en la portada (filas con línea y foto a la derecha). Estática: no lee la base.
// Movimiento con los atributos del motor (src/scripts/motion.js): títulos por líneas, filas en cascada, fotos que se abren con clip.
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Tareas from '../../components/inner/Tareas.astro';
import Foto from '../../components/inner/Foto.astro';
import { u } from '../../lib/entorno';
import { clinica, servicios } from '../../data/site';
import { nb } from '../../components/inner/texto';

const por = (slugs: string[]) => slugs.map((s) => servicios.find((x) => x.slug === s)!);
const grupos = [
  { titulo: 'Estudios y diagnóstico', items: por(['tomografia', 'rayos-x', 'laboratorio', 'video-endoscopia']) },
  { titulo: 'Cirugía y unidades especializadas', items: por(['cirugia', 'uci', 'cirugia-bariatrica', 'obstetrica-neonatal']) },
];
---
<Layout titulo="Servicios" descripcion="Tomografía, rayos X, laboratorio, video endoscopia, cirugía, UCI y unidades especializadas en la Policlínica Maracaibo, Av. 8 Santa Rita.">
  <PageHero titulo="Servicios" lead={`Estudios, cirugía y cuidados intensivos en un mismo edificio, en la ${clinica.direccion}. Elige uno para ver su horario y pedir cita.`} migas={[{ texto: 'Servicios' }]} />

  <section class="section">
    <div class="wrap">
      {grupos.map((g) => (
        <div class="grupo">
          <h2 class="h-lg" data-split="lines">{g.titulo}</h2>
          <ul class="filas" data-stagger=".08">
            {g.items.map((s) => (
              <li>
                <a href={u(`/servicios/${s.slug}/`)}>
                  <span class="filas__nombre">{s.nombre}</span>
                  <span class="filas__txt">
                    <span>{s.resumen}</span>
                    {s.horario && <span class="filas__hora">{nb(s.horario)}</span>}
                  </span>
                  <Foto class="filas__foto" src={s.imagen} pos={s.pos} ratio="4/3" widths={[240, 480]} sizes="224px" delay=".1" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="esp" data-reveal="up"><b>Especialidades</b> Los médicos de la Policlínica, agrupados por especialidad. <a class="link" href={u('/especialidades/')}>Ver las especialidades</a></p>
    </div>
  </section>

  <section class="section cierre">
    <div class="wrap cierre__grid">
      <div>
        <h2 class="h-xl" data-split="lines">Pide tu cita o llama a la central</h2>
        <p data-reveal="up" data-delay=".15">{nb(clinica.horario.citas)} Central <a class="link" href={clinica.telefono.href}>{clinica.telefono.texto}</a>.</p>
      </div>
      <Tareas />
    </div>
  </section>
</Layout>

<style>
  .grupo + .grupo { margin-top: 3.5rem; }
  .grupo h2 { margin-bottom: 1rem; }
  .filas { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .filas a { display: grid; grid-template-columns: 17rem 1fr auto; gap: 1.5rem; align-items: center; padding: 1rem .8rem; border-bottom: 1px solid var(--line); transition: background .2s; }
  .filas a:hover { background: var(--mist); }
  .filas__nombre { font: 600 1.3125rem var(--font-head); letter-spacing: -.02em; color: var(--blue); text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1.5px; }
  .filas__txt { display: grid; gap: .25rem; max-width: 52ch; }
  .filas__hora { font-weight: 600; color: var(--navy); }
  /* las ocho miniaturas con el mismo marco 4:3 */
  .filas :global(.filas__foto) { width: 224px; justify-self: end; }
  .esp { margin-top: 2.5rem; font-size: 1.0625rem; } /* sin raya propia: la de la última fila ya la separa */
  .esp b { font-family: var(--font-head); font-weight: 600; color: var(--navy); margin-right: .6rem; }
  .cierre { background: var(--mist); padding-block: clamp(3rem, 6vw, 4.5rem); }
  .cierre__grid { display: grid; grid-template-columns: 1fr auto; gap: 2rem 4rem; align-items: center; }
  .cierre__grid > div { display: grid; gap: .8rem; }
  .cierre h2 { max-width: 18ch; }

  @media (max-width: 960px) {
    .filas a { grid-template-columns: 1fr auto; gap: .3rem 1rem; }
    .filas__nombre, .filas__txt { grid-column: 1; }
    /* la miniatura se achica con la pantalla (antes guardaba sus 224 px y la fila se salía a 360 px) */
    .filas :global(.filas__foto) { grid-column: 2; grid-row: 1 / 3; width: clamp(96px, 30vw, 128px); }
    .cierre__grid { grid-template-columns: 1fr; }
  }
</style>
