// Cloudflare Workers (plan gratis). El adaptador de Astro completa "main" y "assets" al compilar.
// Primer despliegue: npx wrangler d1 create policlinica → pegar el database_id abajo → npm run db:remote → npm run deploy
// Secreto de sesión: npx wrangler secret put SESSION_SECRET  (en local va en .dev.vars). Primer admin: node tools/usuario.mjs --remote …
{
  "name": "policlinica-maracaibo",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "policlinica", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // 5 intentos de inicio de sesión por minuto e IP
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "workers_dev": true
  // Con el dominio en Cloudflare: "routes": [{ "pattern": "www.policlinicamaracaibo.com", "custom_domain": true }]
}
