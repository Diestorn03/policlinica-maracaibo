# Copiar a .env junto a dist/ en el servidor (npm start lo lee solo). No subir este archivo a GitHub.
HOST=127.0.0.1
PORT=4321
# 32 caracteres al azar como mínimo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Carpeta de la base SQLite (policlinica.db). Fuera de la carpeta de la app si se va a reemplazar el paquete al actualizar.
DATA_DIR=./data
# Primer administrador: solo se crea si todavía no existe ninguno. Después se pueden borrar estas tres líneas.
ADMIN_CORREO=
ADMIN_NOMBRE=Administración
ADMIN_CLAVE=
# Servidor Jitsi de la videollamada. Vacío = el público meet.jit.si (ver docs/DESPLIEGUE.md).
JITSI_DOMAIN=
