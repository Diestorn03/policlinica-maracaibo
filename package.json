{
  "name": "policlinica-maracaibo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply policlinica --local",
    "db:remote": "wrangler d1 migrations apply policlinica --remote",
    "seed": "node tools/seed.mjs",
    "test": "node tests/db.check.mjs",
    "types": "wrangler types src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.1",
    "astro": "7.4.1",
    "gsap": "3.15.0",
    "lenis": "1.3.27"
  },
  "devDependencies": {
    "wrangler": "4.151.2"
  }
}
