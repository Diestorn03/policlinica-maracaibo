{
  "name": "policlinica-maracaibo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:demo": "astro dev --mode demo --port 4331",
    "build": "astro build",
    "build:demo": "astro build --mode demo",
    "dev:node": "astro dev --mode node",
    "build:node": "astro build --mode node",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply policlinica --local",
    "db:remote": "wrangler d1 migrations apply policlinica --remote",
    "seed": "node tools/seed.mjs",
    "test": "node tests/db.check.mjs && node tests/sitio.check.mjs",
    "types": "wrangler types src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "7.4.1",
    "gsap": "3.15.0",
    "lenis": "1.3.27"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "14.4.1",
    "wrangler": "4.151.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
